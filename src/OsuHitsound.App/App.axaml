<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuHitsound.App.App"
             RequestedThemeVariant="Dark">
  <!-- Colour and size tokens are added at start-up by ThemeResources (from UiTheme); see docs/design-system.md. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OsuHitsoundEditor/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The interface font (UI refresh, 2026-11-13): Nunito, a rounded sans in the spirit of osu!lazer's. Fluent
           reads this key for every window and pop-up; Inter stays as the fallback. -->
      <FontFamily x:Key="ContentControlThemeFontFamily">avares://OsuHitsoundEditor/Assets/Fonts#Nunito, fonts:Inter#Inter, $Default</FontFamily>
      <FontFamily x:Key="MonoFont">avares://OsuHitsoundEditor/Assets/Fonts#Roboto Mono, Consolas, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://OsuHitsoundEditor/DesignSystem.axaml" />
  </Application.Styles>
</Application>
