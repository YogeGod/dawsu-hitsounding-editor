<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:OsuHitsound.App">
  <!--
    The design system's control styles (docs/design-system.md). Colours and sizes are tokens: UiTheme holds them and
    ThemeResources puts them into the application's resources, so the UI inspector can change any of them live.
    Classes:
      Button            default: grey, 30 px, 2 px corners          Button.primary   the screen's main action (blue)
      Button.flat       text-only, lights up on hover               Button.icon      a square icon button
      ToggleButton      switched on = blue                          ToggleButton.tool  a tool in a joined tool row
      .transport        a joined transport button (.playing = green, Cycle on = gold, .record on = red)
      RadioButton.tab   a tab with an underline                     Border.header / toolbar / info / transportBar / footer
      (Dialogs use Button.primary for OK and Save.)
      TextBlock.fieldLabel / fieldValue / toolLabel / caption / lcd / sectionLabel
  -->

  <!-- Base -->
  <!-- Nunito reads thin at regular weight on the dark panels, so the interface's text is semibold (the design's weight);
       pop-ups (menus, tooltips, flyouts) are their own top levels. -->
  <Style Selector=":is(TopLevel)">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter, ToggleButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlPressed}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter, ToggleButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter, Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonActive}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActiveBorder}" />
  </Style>
  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter, Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonActiveHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActiveBorder}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActiveBorder}" />
  </Style>
  <Style Selector="Window.editorDialog Button">
    <Setter Property="MinWidth" Value="64" />
  </Style>
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
  </Style>

  <!-- Text-only buttons (Open…, links in bars) -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
  </Style>

  <!-- Square icon buttons -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Studio chrome: quiet icon surfaces, shared by both palettes. -->
  <Style Selector="Button.icon, ToggleButton.icon, Button.transport, ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelActive}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonActive}" />
  </Style>
  <Style Selector="Border.toolbar ComboBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.info TextBlock.fieldLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tools: a joined row of square buttons; the selected tool is light with a dark icon -->
  <Style Selector="Border.tools">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.tools > StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter, ToggleButton.tool:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ToolActive}" />
    <Setter Property="Foreground" Value="{DynamicResource ToolActiveIcon}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Transport: joined square buttons; Play turns green while playing, Cycle gold when on, Record red -->
  <Style Selector="Button.transport, ToggleButton.transport">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.transport.wide">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Button.transport.playing /template/ ContentPresenter, Button.transport.playing:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayBg}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="ToggleButton.transport:checked /template/ ContentPresenter, ToggleButton.transport:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CycleBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="ToggleButton.transport.record:checked /template/ ContentPresenter, ToggleButton.transport.record:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RecordBg}" />
  </Style>
  <Style Selector="ToggleButton.transport.record Ellipse">
    <Setter Property="Fill" Value="{DynamicResource RecordBg}" />
  </Style>
  <Style Selector="ToggleButton.transport.record:checked Ellipse">
    <Setter Property="Fill" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="ToggleButton.wide">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Text boxes, lists, tooltips -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource FieldBg}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
  </Style>
  <!-- Number boxes pass their own alignment to the text box inside them. -->
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox:focus-visible, TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MaxWidth" Value="440" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource HeaderText}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- Tabs: dim text, the chosen one bright and underlined -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="TabBorder" Padding="14,8" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#TabBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#TabBorder, RadioButton.tab:focus-visible /template/ Border#TabBorder">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
  </Style>

  <!-- Bars, top to bottom -->
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{DynamicResource HeaderBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
  </Style>
  <Style Selector="Border.info">
    <Setter Property="Background" Value="{DynamicResource InfoBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
  </Style>
  <Style Selector="Border.transportBar">
    <Setter Property="Background" Value="{DynamicResource StatusBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
  </Style>
  <Style Selector="Border.footer">
    <Setter Property="Background" Value="{DynamicResource FooterBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
  </Style>

  <!-- The window's own title bar: flat caption buttons; Close turns red -->
  <Style Selector="Button.windowButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{DynamicResource WindowBarHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WindowText}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.windowButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22000000" />
    <Setter Property="Foreground" Value="{DynamicResource WindowText}" />
  </Style>
  <Style Selector="Button.windowButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#44000000" />
  </Style>
  <Style Selector="Button.windowButton.close:pointerover /template/ ContentPresenter, Button.windowButton.close:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WindowClose}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- The app mark and file name in the menu bar -->
  <Style Selector="Border.logo">
    <Setter Property="Background" Value="{DynamicResource Brand}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Border.logo TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.appTitle">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.projectName">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Labels and values -->
  <Style Selector="StackPanel.field">
    <Setter Property="Margin" Value="0,0,18,0" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.fieldLabel, TextBlock.sectionLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.fieldValue">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.toolLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The time display -->
  <Style Selector="TextBlock.lcd">
    <Setter Property="Foreground" Value="{DynamicResource LcdText}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource LcdFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource LcdCaption}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Ribbon (the editor's toolbar): groups of icon + label buttons. Last in the file so it overrides the square
       tool and icon sizes above. The window sets narrow, compact or iconsOnly on the bar as it shrinks. -->
  <Style Selector="StackPanel.ribbonGroup">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="7,0" />
  </Style>
  <Style Selector="TextBlock.ribbonCaption">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,3,0" />
  </Style>
  <Style Selector="Border.ribbonSep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="{DynamicResource ChromeBorder}" />
  </Style>
  <!-- A ribbon tile (UI refresh, 2026-11-13): the icon over its label, on a visible surface, so every button names
       itself. Tool tiles stay solid when chosen; switches that are on take a tint and an underline in the accent. -->
  <Style Selector="Button.ribbon, ToggleButton.ribbon">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbon > StackPanel, ToggleButton.ribbon > StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="Button.ribbon > StackPanel > :is(Control), ToggleButton.ribbon > StackPanel > :is(Control)">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbon > StackPanel > app|AppIcon, ToggleButton.ribbon > StackPanel > app|AppIcon">
    <Setter Property="Size" Value="20" />
  </Style>
  <Style Selector="Button.ribbon TextBlock, ToggleButton.ribbon TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.ribbon:not(.tool):checked /template/ ContentPresenter, ToggleButton.ribbon:not(.tool):checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <!-- The underline takes 2 px at the bottom; the padding keeps the icon and label where they are when off. -->
  <Style Selector="ToggleButton.ribbon:not(.tool):checked">
    <Setter Property="Padding" Value="6,2,6,0" />
  </Style>
  <Style Selector="ToggleButton.tool.ribbon:checked /template/ ContentPresenter, ToggleButton.tool.ribbon:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ToolActive}" />
    <Setter Property="Foreground" Value="{DynamicResource ToolActiveIcon}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.tool.ribbon:checked TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ToggleButton.tool.ribbon">
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
  </Style>
  <!-- Tiles with no label left (narrow windows) shrink back to square icon buttons. -->
  <Style Selector="Border.iconsOnly Button.ribbon, Border.iconsOnly ToggleButton.ribbon">
    <Setter Property="Height" Value="32" />
  </Style>

  <!-- Save in the title bar, the lane switches beside the lane filter, Fit beside the time zoom, the fold arrow and
       title of a panel header. -->
  <Style Selector="Button.titleSave">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.laneSwitch">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.zoomFit">
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ToggleButton.icon.fold">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.icon.fold:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.paneTitle">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.narrow TextBlock.ribbonCaption, Border.compact TextBlock.ribbonCaption, Border.iconsOnly TextBlock.ribbonCaption">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.compact TextBlock.ribbonText.secondary, Border.iconsOnly TextBlock.ribbonText">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.iconsOnly TextBlock.ribbonText.keep">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.iconsOnly StackPanel.ribbonGroup">
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="Border.iconsOnly Button.ribbon, Border.iconsOnly ToggleButton.ribbon">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Padding" Value="3,0" />
  </Style>
  <!-- Menus (layout D): shortcut chips, switches instead of checkmarks, rows of choice buttons. Part names are the
       Fluent MenuItem template's (Avalonia.Themes.Fluent 11.3). -->
  <!-- Fidelity pass (2026-11-13): Play is always green; the time display is divided; hints show their keys as chips;
       a bottom panel's tabs and the inspector's two-way choices are quiet pills; the drum map switch is named. -->
  <Style Selector="Button.transport.play">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.transport.play /template/ ContentPresenter, Button.transport.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PlayBg}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Border.lcdCell">
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="StackPanel.keyHint">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="StackPanel.keyHint > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A ribbon drop-down with its caption inside the box, above the value (the design's Snap to / Spacing). -->
  <Style Selector="ComboBox.captioned">
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,13,0,0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBlock.boxCaption">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Margin" Value="11,5,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.titleChip">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,3,4,3" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Border.modePill">
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.modePill > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.keyChip">
    <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.keyChip > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
  </Style>
  <Style Selector="RadioButton.pilltab">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="TabBorder" Padding="10,3" CornerRadius="8" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.pilltab:checked">
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.pilltab:checked /template/ Border#TabBorder">
    <Setter Property="Background" Value="{DynamicResource LineDivider}" />
  </Style>
  <Style Selector="RadioButton.pilltab:pointerover /template/ Border#TabBorder, RadioButton.pilltab:focus-visible /template/ Border#TabBorder">
    <Setter Property="Background" Value="{DynamicResource ControlHover}" />
  </Style>
  <Style Selector="StackPanel.segment.quiet > ToggleButton:checked /template/ ContentPresenter, StackPanel.segment.quiet > ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LineDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
  </Style>
  <!-- The lane header's view switch: Samples | Drum map, two joined halves. -->
  <Style Selector="Border.switchBack">
    <Setter Property="Background" Value="{DynamicResource FieldBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ToggleButton.viewSwitch">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.viewSwitch:checked /template/ ContentPresenter, ToggleButton.viewSwitch:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
  </Style>
  <Style Selector="ToggleButton.drumMap">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="#29ff9550" />
    <Setter Property="Foreground" Value="#ffb488" />
    <Setter Property="BorderBrush" Value="#ff9550" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.drumMap:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#44ff9550" />
    <Setter Property="Foreground" Value="#ffd0b0" />
    <Setter Property="BorderBrush" Value="#ff9550" />
  </Style>
  <Style Selector="ToggleButton.drumMap:checked /template/ ContentPresenter, ToggleButton.drumMap:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#ff9550" />
    <Setter Property="Foreground" Value="#2a1200" />
    <Setter Property="BorderBrush" Value="#ff9550" />
  </Style>
  <!-- UI refresh (2026-11-13): each menu row is rounded inside the rounded menu panel (ThemeResources sets the
       panel's corners and padding); a switch that is on takes the accent colour, so pink stays the brand's alone. -->
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="MenuItem.hasKey /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Background" Value="{DynamicResource LcdBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem.switch /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="MenuItem.switch Border.switchTrack">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource ChromeBorder}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem.switch Border.switchKnob">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Background" Value="#dddddd" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="MenuItem.switch:checked Border.switchTrack">
    <Setter Property="Background" Value="{DynamicResource ButtonActive}" />
  </Style>
  <Style Selector="MenuItem.switch:checked Border.switchKnob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Background" Value="#ffffff" />
  </Style>
  <Style Selector="StackPanel.segment">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>
  <Style Selector="StackPanel.segment > ToggleButton">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,-1,0" />
  </Style>
  <Style Selector="StackPanel.segment > ToggleButton:nth-child(1)">
    <Setter Property="CornerRadius" Value="8,0,0,8" />
  </Style>
  <Style Selector="StackPanel.segment > ToggleButton:nth-last-child(1)">
    <Setter Property="CornerRadius" Value="0,8,8,0" />
  </Style>
  <Style Selector="StackPanel.zoomEnd">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.zoomStep">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Plain small + and − at the ends of the zoom sliders: no button under them until the pointer is over one. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Border.saveBadge">
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A flat slider (UI refresh): a thin track, the filled part in the accent, a plain round handle. It replaces
       Fluent's, whose handle was clipped and sat low in the 22 px rows of the mixer. -->
  <Styles.Resources>
    <!-- A thin scrollbar (UI refresh): a rounded handle that stays the same size when the pointer is over it, no
         arrow buttons. It replaces Fluent's, which grows on hover. -->
    <ControlTheme x:Key="ThinScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover, ^:pressed">
        <Setter Property="Opacity" Value="0.8" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ThinScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ThinScrollPage}" /></Track.DecreaseButton>
                <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ThinScrollPage}" /></Track.IncreaseButton>
                <Thumb Theme="{StaticResource ThinScrollThumb}" Width="6" MinHeight="24" HorizontalAlignment="Center" />
              </Track>
            </Border>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}" Orientation="Horizontal">
                <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ThinScrollPage}" /></Track.DecreaseButton>
                <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ThinScrollPage}" /></Track.IncreaseButton>
                <Thumb Theme="{StaticResource ThinScrollThumb}" Height="6" MinWidth="24" VerticalAlignment="Center" />
              </Track>
            </Border>
          </ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="FlatSliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource ButtonText}" CornerRadius="6" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="FlatSliderRunH" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent"><Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" /></Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="FlatSliderRunV" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent"><Border Width="4" HorizontalAlignment="Center" Background="{TemplateBinding Background}" /></Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
      <Setter Property="Background" Value="Transparent" />
      <Style Selector="^:horizontal">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="{TemplateBinding Background}">
              <Border Height="4" CornerRadius="2" Margin="2,0" VerticalAlignment="Center" Background="{DynamicResource LineDivider}" />
              <Track Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource FlatSliderRunH}" Background="{DynamicResource ButtonActive}" Margin="2,0,-4,0" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource FlatSliderRunH}" Background="Transparent" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="12" Height="12" Theme="{StaticResource FlatSliderThumb}" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:vertical">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="{TemplateBinding Background}">
              <Border Width="4" CornerRadius="2" Margin="0,2" HorizontalAlignment="Center" Background="{DynamicResource LineDivider}" />
              <Track Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource FlatSliderRunV}" Background="{DynamicResource ButtonActive}" Margin="0,-4,0,2" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource FlatSliderRunV}" Background="Transparent" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="12" Height="12" Theme="{StaticResource FlatSliderThumb}" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <!-- The zoom sliders at the ends of the scrollbars look like the scrollbars: a grey rounded handle on a thin groove. -->
    <ControlTheme x:Key="ZoomSliderThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover, ^:pressed">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ZoomSlider" TargetType="Slider">
      <Setter Property="Background" Value="Transparent" />
      <Style Selector="^:horizontal">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="{TemplateBinding Background}">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource LineDivider}" />
              <Track Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource ThinScrollPage}" /></Track.DecreaseButton>
                <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource ThinScrollPage}" /></Track.IncreaseButton>
                <Thumb Name="thumb" Width="18" Height="6" Theme="{StaticResource ZoomSliderThumb}" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="^:vertical">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="{TemplateBinding Background}">
              <Border Width="4" CornerRadius="2" HorizontalAlignment="Center" Background="{DynamicResource LineDivider}" />
              <Track Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource ThinScrollPage}" /></Track.DecreaseButton>
                <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource ThinScrollPage}" /></Track.IncreaseButton>
                <Thumb Name="thumb" Width="6" Height="18" Theme="{StaticResource ZoomSliderThumb}" />
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Slider.zoom">
    <Setter Property="Theme" Value="{StaticResource ZoomSlider}" />
  </Style>
</Styles>
