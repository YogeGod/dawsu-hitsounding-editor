<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:OsuHitsound.App"
             x:Class="OsuHitsound.App.KeysoundEditor"
             Background="{DynamicResource VolumeSide}">
  <!-- The same rows and controls as the Hitsound editor: ribbon, overview, editing area with the controller, transport.
       Messages show behind the title bar's details icon, as in the Hitsound editor. -->
  <Grid Name="Layout" RowDefinitions="Auto,20,*,56" ColumnDefinitions="250,4,*">
    <!-- Ribbon, as the Hitsound editor's (layout D2): labelled buttons in captioned groups, Save project on the right.
         Captions, then secondary labels, then all labels but Save's hide as the window narrows (RibbonFit). -->
    <Border Grid.ColumnSpan="3" Name="ControlBar" Classes="toolbar" BorderThickness="0,0,0,1">
      <Grid Name="ControlBarContent" ColumnDefinitions="*,Auto" Margin="6,5">
        <StackPanel Name="RibbonGroups" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
          <StackPanel Classes="ribbonGroup">
            <Button Name="OpenButton" Classes="ribbon" AutomationProperties.Name="Open" ToolTip.Tip="Open a map or Keysound project (Ctrl+O)">
              <StackPanel><app:AppIcon Glyph="OsuOpen" /><TextBlock Classes="ribbonText secondary" Text="Open" /></StackPanel>
            </Button>
            <Button Name="ImportMidiButton" Classes="ribbon" AutomationProperties.Name="Import MIDI" ToolTip.Tip="Import a MIDI file as new tracks (one undo step)">
              <StackPanel><app:AppIcon Glyph="Download" /><TextBlock Classes="ribbonText secondary" Text="MIDI" /></StackPanel>
            </Button>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <Button Name="UndoButton" Classes="ribbon" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
              <StackPanel><app:AppIcon Glyph="OsuUndo" /><TextBlock Classes="ribbonText secondary" Text="Undo" /></StackPanel>
            </Button>
            <Button Name="RedoButton" Classes="ribbon" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
              <StackPanel><app:AppIcon Glyph="OsuRedo" /><TextBlock Classes="ribbonText secondary" Text="Redo" /></StackPanel>
            </Button>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="SelectTool" Classes="tool ribbon" IsChecked="True" AutomationProperties.Name="Select">
              <StackPanel><app:AppIcon Glyph="MousePointer2" /><TextBlock Classes="ribbonText" Text="Select" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="GrabTool" Classes="tool ribbon" AutomationProperties.Name="Grab">
              <StackPanel><app:AppIcon Glyph="Hand" /><TextBlock Classes="ribbonText" Text="Grab" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="DrawTool" Classes="tool ribbon" AutomationProperties.Name="Draw">
              <StackPanel><app:AppIcon Glyph="Drumstick" /><TextBlock Classes="ribbonText" Text="Draw" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="EraseTool" Classes="tool ribbon" AutomationProperties.Name="Erase">
              <StackPanel><app:AppIcon Glyph="Eraser" /><TextBlock Classes="ribbonText" Text="Erase" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="MuteTool" Classes="tool ribbon" AutomationProperties.Name="Mute">
              <StackPanel><app:AppIcon Glyph="VolumeX" /><TextBlock Classes="ribbonText" Text="Mute" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="SplitTool" Classes="tool ribbon" AutomationProperties.Name="Split">
              <StackPanel><app:AppIcon Glyph="Scissors" /><TextBlock Classes="ribbonText" Text="Split" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="GlueTool" Classes="tool ribbon" AutomationProperties.Name="Glue">
              <StackPanel><app:AppIcon Glyph="Link2" /><TextBlock Classes="ribbonText" Text="Glue" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="SnapToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Snap" ToolTip.Tip="Snapping on / off (J)">
              <StackPanel><app:AppIcon Glyph="OsuSnap" /><TextBlock Classes="ribbonText" Text="Snap" /></StackPanel>
            </ToggleButton>
            <ComboBox Name="SnapModeBox" Width="102" Focusable="True" ToolTip.Tip="Grid: land on grid lines. Grid relative: keep the offset from the grid. Objects: snap to the reference's circles, slider nodes and spinner ends." />
            <ComboBox Name="SnapBox" Width="64" Focusable="True" ToolTip.Tip="Snap spacing: 2/1, 3/1 or 4/1 means every 2, 3 or 4 beats from each red timing point; also the length of drawn notes, nudges and Quantize (Q). Shift+1–9 selects 1/n; Alt+wheel cycles snaps." />
            <ToggleButton Name="MarkerToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Gameplay-object lines"
                          ToolTip.Tip="Vertical lines at the reference's circles, slider heads, repeats and tails, and spinner ends. Notes drawn on a line still need Sync before Generate.">
              <StackPanel><app:AppIcon Glyph="OsuLines" /><TextBlock Classes="ribbonText secondary" Text="Object lines" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="TripletSnapToggle" Classes="ribbon" AutomationProperties.Name="Triplets"
                          ToolTip.Tip="Alt+wheel: on cycles 3/1, 1/1, 1/3, 1/6, 1/12; off cycles 4/1, 2/1, 1/1, 1/2, 1/4, 1/8, 1/16. The drop-down offers every spacing; Shift+number still selects 1/n.">
              <StackPanel><app:AppIcon Glyph="OsuTriplets" /><TextBlock Classes="ribbonText secondary" Text="Triplets" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="HearToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Audition"
                          ToolTip.Tip="Hear notes while editing: clicked keys, drawn, selected and re-pitched notes. Saved for all projects.">
              <StackPanel><app:AppIcon Glyph="OsuAudition" /><TextBlock Classes="ribbonText secondary" Text="Audition" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="TypingToggle" Classes="ribbon" AutomationProperties.Name="Musical typing"
                          ToolTip.Tip="Musical typing (Alt+K): play the selected track with your computer keyboard. While it's on, only Space (play/stop) and Esc (close) keep their editor meaning.">
              <StackPanel><app:AppIcon Glyph="KeyboardMusic" /><TextBlock Classes="ribbonText secondary" Text="Typing" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="GhostToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Ghost notes"
                          ToolTip.Tip="Ghost notes: show other tracks' notes faintly. Only the selected track is editable.">
              <StackPanel><app:AppIcon Glyph="Ghost" /><TextBlock Classes="ribbonText secondary" Text="Ghosts" /></StackPanel>
            </ToggleButton>
          </StackPanel>
        </StackPanel>
        <!-- The inspector's switch sits alone at the far right, as the Hitsound ribbon's panel switches. Save project is
             the title bar's Save button (MainWindow) while the key editor shows. -->
        <StackPanel Grid.Column="1" Name="RibbonPanels" Classes="ribbonGroup" Margin="8,0,0,0">
            <ToggleButton Name="InspectorToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Inspector"
                          ToolTip.Tip="Show the inspector beside the keys: selection, tracks, instrument and MIDI input">
              <StackPanel><app:AppIcon Glyph="OsuInspector" /><TextBlock Classes="ribbonText secondary" Text="Inspector" /></StackPanel>
            </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The inspector: the same foldable, movable cards as the Hitsound editor's. The card bodies below are moved into it. -->
    <app:KeysoundInspector Grid.Row="1" Grid.RowSpan="2" Name="Side" Background="{DynamicResource VolumeSide}" />
    <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Name="InspectorSplitter" ResizeDirection="Columns" Background="{DynamicResource Divider}" />
    <StackPanel Name="CardBodies" IsVisible="False">
      <!-- Selection, as the Hitsound inspector's Selection card: what is selected, where it starts, its velocity. -->
      <StackPanel Name="SelectionBody" Spacing="6">
        <TextBlock Name="InfoSelection" Text="Nothing selected" Classes="fieldValue" />
        <TextBlock Name="SelectionHelp" Text="Select notes to change their time and velocity here." TextWrapping="Wrap" FontSize="11" Opacity="0.85" />
        <StackPanel Name="SelectionFields" Spacing="6" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Start · ms" Classes="toolLabel" />
            <TextBox Grid.Column="1" Name="StartBox" Width="88" Watermark="—" ToolTip.Tip="Where the selection starts, in ms. Type a time and press Enter to move it there (several: all move together); Esc puts it back." />
          </Grid>
          <TextBlock Name="InfoStart" Text="" Classes="fieldLabel" HorizontalAlignment="Right" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Pitch" Classes="toolLabel" />
            <TextBlock Grid.Column="1" Name="InfoPitch" Text="—" Classes="fieldValue" HorizontalAlignment="Right" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBlock Text="Velocity · 1–127" Classes="toolLabel" />
            <TextBox Grid.Column="1" Name="VelocityValueBox" Width="52" Watermark="1-127" ToolTip.Tip="Velocity of the selected notes. Enter or Apply commits the value." />
            <Button Grid.Column="2" Name="VelocityApplyButton" Content="Apply" Focusable="True" ToolTip.Tip="Apply to the selected notes (one undo step)" />
          </Grid>
          <StackPanel Spacing="3">
            <TextBlock Text="Change" Classes="toolLabel" />
            <ComboBox HorizontalAlignment="Left" Name="VelocityModeBox" Width="110" Focusable="True" ToolTip.Tip="Relative moves every selected velocity by the value; Set all gives them that value" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Object" Classes="toolLabel" />
            <TextBlock Grid.Column="1" Name="InfoObject" Text="—" Classes="fieldValue" TextWrapping="Wrap" ToolTip.Tip="The gameplay object the selection is synced to" />
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <Button Name="SelectionQuantizeButton" Content="Quantize…" Margin="0,0,4,4" ToolTip.Tip="Quantize the selected notes to the grid" />
            <Button Name="SelectionDuplicateButton" Content="Duplicate" Margin="0,0,4,4" ToolTip.Tip="Duplicate the selected notes (Ctrl+D)" />
            <Button Name="SelectionDeleteButton" Content="Delete" Margin="0,0,4,4" ToolTip.Tip="Delete the selected notes (Del)" />
          </WrapPanel>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Text="New notes · velocity" Classes="toolLabel" />
          <NumericUpDown Grid.Column="1" Name="InsertVelocityBox" Minimum="1" Maximum="127" Increment="1" Value="100" FormatString="0" Width="104"
                         AutomationProperties.Name="Insert velocity" ToolTip.Tip="Velocity for newly drawn and typed notes (1–127). Remembered for all projects." />
        </Grid>
      </StackPanel>
      <StackPanel Name="TracksBody" Spacing="6">
        <Border Padding="8,5" CornerRadius="4" Background="{DynamicResource ButtonBg}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ToggleButton Name="SongRowMute" Content="M" Width="24" Height="22" MinHeight="22" Padding="0" FontSize="11" HorizontalContentAlignment="Center" ToolTip.Tip="Mute the song" />
              <ToggleButton Name="SongRowSolo" Content="S" Width="24" Height="22" MinHeight="22" Padding="0" FontSize="11" HorizontalContentAlignment="Center" ToolTip.Tip="Solo the song: hear it without the tracks" />
            </StackPanel>
            <TextBlock Text="Song audio" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <StackPanel Name="TrackList" Spacing="4" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Name="AddTrackButton" Content="+ Track" ToolTip.Tip="Add an instrument track with the bundled piano" />
          <Button Name="RenameTrackButton" Content="Rename…" ToolTip.Tip="Rename the selected track" />
          <Button Name="DeleteTrackButton" Content="Delete" ToolTip.Tip="Delete the selected track. Undo brings it back with its notes." />
        </StackPanel>
      </StackPanel>
      <StackPanel Name="InstrumentBody" Spacing="6">
        <TextBlock Name="InstrumentText" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Button Name="InstrumentButton" Content="Instrument…" Margin="0,0,6,4" ToolTip.Tip="Play the selected track with the bundled piano or a VST3 instrument. Its notes stay as they are (undoable)." />
          <Button Name="EditorButton" Content="Open editor" Margin="0,0,6,4" ToolTip.Tip="Show the VST3 instrument's own window" />
          <Button Name="FixButton" Margin="0,0,6,4" IsVisible="False" />
        </WrapPanel>
        <CheckBox Name="EffectsBox" Content="Reverb and chorus" IsVisible="False"
                  ToolTip.Tip="The SoundFont's own reverb and chorus. Off gives dry keysounds (no reverb tail in the generated WAVs)." />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Volume (dB)" VerticalAlignment="Center" />
          <NumericUpDown Name="VolumeBox" Minimum="-60" Maximum="12" Increment="1" FormatString="0.#" Width="110"
                         ToolTip.Tip="The selected track's level in the generated WAVs (osu! has one volume per object, so the balance between tracks is baked in)" />
        </StackPanel>
      </StackPanel>
      <StackPanel Name="MidiBody" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ComboBox Name="MidiInputBox" Width="180" ToolTip.Tip="MIDI keyboard input (all channels)" />
          <Button Name="MidiRescanButton" Classes="icon" ToolTip.Tip="Look for MIDI keyboards again (after plugging one in)" AutomationProperties.Name="Look for MIDI keyboards">
            <app:AppIcon Glyph="RotateCw" />
          </Button>
        </StackPanel>
        <TextBlock Text="Played notes go to the selected track's instrument. Record (Numpad *) records into it. Musical typing (Alt+K) plays it from your computer keyboard." TextWrapping="Wrap" FontSize="11" Opacity="0.85" />
      </StackPanel>
      <!-- Bookmarks, as the Hitsound inspector's card: the list, add and remove, and a label for the selected one. -->
      <StackPanel Name="BookmarksBody" Spacing="6">
        <ListBox Name="BookmarkList" MaxHeight="220" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Name="AddBookmarkButton" Classes="icon" AutomationProperties.Name="Add bookmark at playhead" ToolTip.Tip="Add bookmark at playhead"><app:AppIcon Glyph="CirclePlus" /></Button>
          <Button Name="RemoveBookmarkButton" Classes="icon" AutomationProperties.Name="Remove selected bookmark" ToolTip.Tip="Remove selected bookmark"><app:AppIcon Glyph="Minus" /></Button>
        </StackPanel>
        <TextBox Name="BookmarkNameBox" IsVisible="False" Watermark="Optional bookmark label" MaxLength="120" />
        <Button Name="BookmarkLabelButton" Content="Label" IsVisible="False" />
      </StackPanel>
    </StackPanel>

    <!-- Overview strip: the whole song, the visible range outlined; click or drag to jump there. -->
    <app:OverviewStrip Grid.Row="1" Grid.Column="2" Name="Overview" Margin="64,0,0,0" />

    <!-- The editing area: the roll, then (as the Hitsound editor's) the scrollbars with Cubase-style zoom ends, the
         controller's title row and the velocity lane. The roll draws its velocity lane under its own scrollbar. -->
    <Grid Grid.Row="2" Grid.Column="2" Name="EditArea" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto,Auto,Auto">
      <app:PianoRollView Grid.RowSpan="4" Name="Roll" />
      <DockPanel Grid.Column="1" Name="VScrollColumn">
        <StackPanel Name="RowZoomPanel" DockPanel.Dock="Bottom" Classes="zoomEnd" Orientation="Vertical">
          <Button Name="RowZoomInButton" Classes="zoomStep" Content="+" AutomationProperties.Name="Larger key rows" ToolTip.Tip="Larger key rows (Ctrl+Down, or Ctrl+Shift+wheel)" />
          <Slider Name="RowHeightSlider" Classes="zoom" Orientation="Vertical" Height="64" Focusable="True" AutomationProperties.Name="Key row height" ToolTip.Tip="Key row height" />
          <Button Name="RowZoomOutButton" Classes="zoomStep" Content="−" AutomationProperties.Name="Smaller key rows" ToolTip.Tip="Smaller key rows (Ctrl+Up, or Ctrl+Shift+wheel)" />
        </StackPanel>
        <ScrollBar Name="VScroll" Orientation="Vertical" />
      </DockPanel>
      <DockPanel Grid.Row="1" Name="HScrollRow" Margin="64,0,0,0" Height="20">
        <StackPanel Name="TimeZoomPanel" DockPanel.Dock="Right" Classes="zoomEnd" Orientation="Horizontal">
          <Button Name="FitButton" Classes="zoomFit" AutomationProperties.Name="Fit" ToolTip.Tip="Zoom out to the whole song">
              <StackPanel Orientation="Horizontal" Spacing="4"><app:AppIcon Glyph="OsuFit" Size="12" /><TextBlock Text="Fit" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Name="TimeZoomOutButton" Classes="zoomStep" Content="−" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out in time (G, or Ctrl+wheel)" />
          <Slider Name="ZoomSlider" Classes="zoom" Width="80" Minimum="0" Maximum="1" Value="0.5" Focusable="True" AutomationProperties.Name="Timeline zoom" ToolTip.Tip="Time zoom" />
          <Button Name="TimeZoomInButton" Classes="zoomStep" Content="+" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in on time (H, or Ctrl+wheel)" />
        </StackPanel>
        <ScrollBar Name="HScroll" Orientation="Horizontal" />
      </DockPanel>
      <!-- The controller's title row, as the Hitsound editor's: tabs · Ramp tool and shape · whose notes · hint. -->
      <Border Grid.Row="2" Grid.ColumnSpan="2" Name="ControllerHeader" Height="34" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,1" Background="{DynamicResource PaneTitle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,0,6,0">
          <ToggleButton Grid.Column="4" Name="VelocityToggle" Classes="icon fold" IsChecked="True" Margin="8,0,0,0" AutomationProperties.Name="Velocity controller"
                        ToolTip.Tip="Fold or unfold the velocity controller"><app:AppIcon Glyph="ChevronDown" Size="13" /></ToggleButton>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Velocities" Classes="paneTitle" Margin="0,0,8,0" />
            <RadioButton Name="VelocityTab" Classes="pilltab" Content="Velocity" IsChecked="True" GroupName="ksBottom" Focusable="True" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
            <ToggleButton Name="RampTool" Classes="tool" ToolTip.Tip="Ramp (6). Drag in the velocity lane to draw a velocity ramp." AutomationProperties.Name="Ramp"><app:AppIcon Glyph="TrendingUp" /></ToggleButton>
            <ComboBox Name="RampShapeBox" Width="110" Focusable="True" ToolTip.Tip="Shape of ramps (Shift+drag in the bars, or the Ramp tool)" />
            <TextBlock Text="Select" Classes="toolLabel" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox Name="VelocityMinBox" Width="46" Height="22" MinHeight="22" Padding="3,0" Watermark="min" />
            <TextBlock Text="to" Classes="toolLabel" VerticalAlignment="Center" />
            <TextBox Name="VelocityMaxBox" Width="46" Height="22" MinHeight="22" Padding="3,0" Watermark="max" />
            <Button Name="VelocitySelectButton" Content="Select" Height="22" MinHeight="22" Padding="6,0" Focusable="True" ToolTip.Tip="Select the selected track's notes whose velocity is in this range" />
          </StackPanel>
          <TextBlock Grid.Column="2" Name="ActiveTrackText" Classes="fieldLabel" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip.Tip="The track the velocity lane shows: the selected track" />
          <StackPanel Grid.Column="3" Classes="keyHint" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True"><TextBlock Text="Drag bars" /><Border Classes="keyChip"><TextBlock Text="Ctrl" /></Border><TextBlock Text="spread" /><Border Classes="keyChip"><TextBlock Text="Alt" /></Border><TextBlock Text="paint" /><Border Classes="keyChip"><TextBlock Text="Shift" /></Border><TextBlock Text="ramp" /></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="3" Name="VelocitySpace" IsHitTestVisible="False" />
    </Grid>
    <Border Grid.Row="2" Grid.Column="2" Name="TypingPanel" IsVisible="False" VerticalAlignment="Bottom" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="12,6">
      <!-- Musical typing: which computer key plays which note, shown while it's on. -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Name="TypingTitle" Text="Musical typing" FontWeight="SemiBold" />
          <TextBlock Name="TypingHelp" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <Button Grid.Column="1" Name="TypingCloseButton" Classes="icon flat" VerticalAlignment="Top" AutomationProperties.Name="Close musical typing" ToolTip.Tip="Close musical typing (Esc)"><app:AppIcon Glyph="X" /></Button>
      </Grid>
    </Border>

    <!-- Transport, as in the Hitsound editor: buttons, Cycle, the L/R locators and playback options; the clock; volumes. -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Name="StatusBar" Classes="transportBar" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,*" Margin="12,0">
        <StackPanel Name="TransportLeft" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <StackPanel Name="TransportButtons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Name="StartButton" Classes="transport" ToolTip.Tip="Go to start (Home)" AutomationProperties.Name="Go to start"><app:AppIcon Glyph="OsuStart" Size="20" /></Button>
            <Button Name="StopButton" Classes="transport" ToolTip.Tip="Stop; press again to go to the start" AutomationProperties.Name="Stop"><app:AppIcon Glyph="OsuStop" Size="20" /></Button>
            <Button Name="PlayButton" Classes="transport play" Width="42" Height="36" ToolTip.Tip="Play / stop (Space): the song and the audible tracks' notes" AutomationProperties.Name="Play or stop"><app:AppIcon Name="PlayGlyph" Glyph="OsuPlay" Size="22" /></Button>
            <ToggleButton Name="RecordButton" Classes="transport record" ToolTip.Tip="Record (Numpad *): from the playhead into the selected track, from your MIDI keyboard or musical typing. Notes starting in the recorded range are replaced; Space or Record stops." AutomationProperties.Name="Record">
              <Ellipse Width="12" Height="12" />
            </ToggleButton>
            <ToggleButton Name="LoopButton" Classes="transport icon" Width="30" Padding="0" ToolTip.Tip="Cycle between the L and R locators (L or /). Ctrl+click the ruler sets L, Alt+click sets R, drag in the upper ruler draws a range." AutomationProperties.Name="Cycle between the L and R locators (L)">
              <app:AppIcon Glyph="OsuCycle" Size="20" />
            </ToggleButton>
            <!-- The locators open from here, as in the Hitsound editor: set mostly on the ruler (Ctrl+click L, Alt+click R). -->
            <Button Name="LocatorsButton" Classes="transport" Width="32" Padding="0" AutomationProperties.Name="Locators"
                    ToolTip.Tip="Left and right locators: go to one, or type a time in ms. Ctrl+click the ruler sets L, Alt+click sets R.">
              <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                <TextBlock Text="L/R" FontSize="10" VerticalAlignment="Center" />
                <app:AppIcon Glyph="ChevronUp" Size="9" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <StackPanel Name="LocatorPanel" Spacing="6">
                    <Grid ColumnDefinitions="24,80" Height="28">
                      <Button Name="GoLeftButton" Content="L" Classes="flat" Width="24" Height="28" MinHeight="28" Padding="0" FontSize="10" AutomationProperties.Name="Go to left locator" ToolTip.Tip="Go to the left locator. Ctrl+click the ruler sets it." />
                      <TextBox Grid.Column="1" Name="LeftLocatorBox" Width="80" Height="28" MinHeight="28" FontSize="11" Padding="3,0" Watermark="ms" ToolTip.Tip="Left locator in ms: type a time and press Enter" />
                    </Grid>
                    <Grid ColumnDefinitions="24,80" Height="28">
                      <Button Name="GoRightButton" Content="R" Classes="flat" Width="24" Height="28" MinHeight="28" Padding="0" FontSize="10" AutomationProperties.Name="Go to right locator" ToolTip.Tip="Go to the right locator. Alt+click the ruler sets it." />
                      <TextBox Grid.Column="1" Name="RightLocatorBox" Width="80" Height="28" MinHeight="28" FontSize="11" Padding="3,0" Watermark="ms" ToolTip.Tip="Right locator in ms: type a time and press Enter" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <Border Width="1" Height="20" Background="{DynamicResource ChromeBorder}" />
          <StackPanel Name="PlaybackOptionsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ToggleButton Name="ReturnOnStopButton" Classes="flat icon" Width="30" Padding="0" AutomationProperties.Name="Return to playback start when stopping" ToolTip.Tip="Return to playback start when stopping&#x0a;When stopping playback, return to where playback started"><app:AppIcon Glyph="OsuReturn" Size="20" /></ToggleButton>
            <ToggleButton Name="FollowPlaybackButton" Classes="flat icon" Width="30" Padding="0" IsChecked="True" AutomationProperties.Name="Follow the playhead during playback" ToolTip.Tip="Follow the playhead during playback&#x0a;Scroll the editing view to follow the playhead during playback"><app:AppIcon Glyph="OsuFollow" Size="20" /></ToggleButton>
            <ToggleButton Name="CountInToggle" Classes="flat icon" Width="30" Padding="0" IsChecked="True" AutomationProperties.Name="Count-in" ToolTip.Tip="Count-in: one bar of clicks before recording starts (shorter at the very start of the song)"><app:AppIcon Glyph="Timer" /></ToggleButton>
            <ToggleButton Name="MetronomeToggle" Classes="flat icon" Width="30" Padding="0" IsChecked="True" AutomationProperties.Name="Click" ToolTip.Tip="Click: a metronome while recording, the bar's first beat higher"><app:AppIcon Glyph="Metronome" /></ToggleButton>
            <WrapPanel Name="SpeedPanel" Width="252" Height="28" ItemWidth="42" ItemHeight="28" VerticalAlignment="Center" AutomationProperties.Name="Playback speed" ToolTip.Tip="Playback speed: pitch stays the same" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Name="Lcd" HorizontalAlignment="Center" Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,2" Height="44" VerticalAlignment="Center">
          <Grid Name="LcdColumns" ColumnDefinitions="96,80,48,70" VerticalAlignment="Center">
            <StackPanel Grid.Column="0"><TextBlock Name="TimeText" Classes="lcd" Text="0:00.000" /><TextBlock Classes="caption" Text="TIME" /></StackPanel>
            <Border Grid.Column="1" Classes="lcdCell"><StackPanel><TextBlock Name="BarText" Classes="lcd" Text="1.1.1" /><TextBlock Classes="caption" Text="BAR · BEAT · TICK" /></StackPanel></Border>
            <Border Grid.Column="2" Classes="lcdCell"><StackPanel><TextBlock Name="BpmText" Classes="lcd" Text="—" /><TextBlock Classes="caption" Text="TEMPO" /></StackPanel></Border>
            <Border Grid.Column="3" Classes="lcdCell"><StackPanel><TextBlock Name="MeterText" Classes="lcd" Text="4/4" /><TextBlock Classes="caption" Text="METER" /></StackPanel></Border>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Name="MixControls" Width="308" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Grid Name="GlobalVolumePanel" ColumnDefinitions="44,100,30,*" ColumnSpacing="6" Height="22" ToolTip.Tip="Global volume: the song, tracks and previews together (20–100 %), shared with the Hitsound editor">
            <TextBlock Text="Global" Classes="fieldLabel" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Name="GlobalVolumeSlider" Height="22" MinHeight="0" Width="100" Minimum="20" Maximum="100" Value="20" Focusable="True" VerticalAlignment="Center" AutomationProperties.Name="Global volume" />
            <TextBlock Grid.Column="2" Name="GlobalVolumeText" Text="20%" FontSize="10" VerticalAlignment="Center" />
          </Grid>
          <Grid Name="SongControls" ColumnDefinitions="44,100,30,22,32,*" ColumnSpacing="6" Height="22">
            <TextBlock Text="Song" Classes="fieldLabel" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Name="SongVolumeSlider" Height="22" MinHeight="0" Width="100" Minimum="0" Maximum="100" Value="100" Focusable="True" VerticalAlignment="Center" AutomationProperties.Name="Song volume" ToolTip.Tip="Song volume (the tracks unchanged)" />
            <TextBlock Grid.Column="2" Name="SongVolumeText" Text="100%" FontSize="10" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="3" Name="SongMuteButton" Classes="icon" Width="22" Height="22" MinHeight="22" Padding="0" AutomationProperties.Name="Mute the song" ToolTip.Tip="Mute the song. Soloing a track also silences it."><app:AppIcon Glyph="VolumeX" Size="14" /></ToggleButton>
            <TextBlock Grid.Column="4" Text="Offset" FontSize="9" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" Name="SongOffsetBox" Height="22" MinHeight="22" Padding="1,0" FontSize="10" Text="0" VerticalAlignment="Center" AutomationProperties.Name="Song offset in milliseconds" ToolTip.Tip="Song offset in ms for this project: positive plays the song later. Enter applies. Preferences → Song offset for all maps is added too." />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
