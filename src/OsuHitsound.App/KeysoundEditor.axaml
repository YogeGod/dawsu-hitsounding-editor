<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:OsuHitsound.App"
             x:Class="OsuHitsound.App.KeysoundEditor"
             Background="{DynamicResource VolumeSide}">
  <!-- The same rows as the main window's Hitsound view: toolbar, info bar, editing area, transport, footer. -->
  <Grid RowDefinitions="46,46,*,56,Auto" ColumnDefinitions="250,4,*">
    <!-- Toolbar: undo/redo, tools, snap and hearing; view toggles, MIDI input and zoom on the right. -->
    <Border Grid.ColumnSpan="3" Classes="toolbar" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="UndoButton" Classes="icon" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><Path Data="M 5,3 L 1,7 L 5,11 M 1,7 L 9,7 C 15,7 15,15 9,15" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></Button>
          <Button Name="RedoButton" Classes="icon" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><Path Data="M 11,3 L 15,7 L 11,11 M 15,7 L 7,7 C 1,7 1,15 7,15" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></Button>
        </StackPanel>
        <Border Grid.Column="1" Classes="tools" Margin="12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Name="SelectTool" Classes="tool" IsChecked="True" ToolTip.Tip="Object Selection (1): click or box-select notes; drag to move (Ctrl: one direction, Alt: copy); drag either edge to resize; Ctrl+Shift+drag changes velocity; Shift+double-click selects the later notes of that pitch" AutomationProperties.Name="Select"><Path Data="M 3,1 L 3,14 L 7,10 L 11,15 L 14,13 L 10,8 L 15,7 Z" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></ToggleButton>
            <ToggleButton Name="DrawTool" Classes="tool" ToolTip.Tip="Draw (8): click to add a note at the insert velocity, drag right to set its length; clicking a note deletes it" AutomationProperties.Name="Draw"><Path Data="M 2,11 L 11,2 L 14,5 L 5,14 L 1,15 Z M 9,4 L 12,7" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></ToggleButton>
            <ToggleButton Name="EraseTool" Classes="tool" ToolTip.Tip="Erase (5): click or drag across notes to delete them" AutomationProperties.Name="Erase"><Path Data="M 2,10 L 10,2 L 15,7 L 7,15 L 5,15 Z M 7,5 L 12,10 M 5,15 L 15,15" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></ToggleButton>
            <ToggleButton Name="SplitTool" Classes="tool" ToolTip.Tip="Split (3): click a note to split it at the (snapped) pointer; on a selected note, every selected note splits there" AutomationProperties.Name="Split"><Path Data="M 4,1 L 12,15 M 12,1 L 4,15 M 1,8 L 15,8" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></ToggleButton>
            <ToggleButton Name="GlueTool" Classes="tool" ToolTip.Tip="Glue (4): click a note to join it with the next note of the same pitch" AutomationProperties.Name="Glue"><Path Data="M 3,2 L 3,9 Q 3,14 8,14 Q 13,14 13,9 L 13,2 M 8,2 L 8,10" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" /></ToggleButton>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton Name="SnapToggle" Classes="viewToggle" Content="Snap" IsChecked="True" ToolTip.Tip="Snap notes to the grid (J). The grid counts from each red line of the reference beatmap." />
          <ComboBox Name="SnapBox" Width="70" Focusable="True" ToolTip.Tip="Grid spacing in beats; also the length of drawn notes, nudges and Quantize (Q)" />
          <ToggleButton Name="HearToggle" Classes="viewToggle" Content="Audition" IsChecked="True" Height="28" MinHeight="28" Padding="10,4" Margin="6,0,0,0"
                        ToolTip.Tip="Hear notes while editing: clicked keys, drawn, selected and re-pitched notes" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton Name="GhostToggle" Classes="viewToggle" Content="Ghost notes" IsChecked="True" ToolTip.Tip="Show other tracks' notes faintly. Only the selected track is editable." />
          <ToggleButton Name="MarkerToggle" Classes="viewToggle" Content="Object lines" IsChecked="True" ToolTip.Tip="Vertical lines at the reference's circles, slider heads, repeats and tails, and spinner ends. Notes drawn on a line still need Sync before Generate." />
          <TextBlock Text="MIDI" Classes="toolLabel" Margin="6,0,0,0" />
          <ComboBox Name="MidiInputBox" Width="180" ToolTip.Tip="MIDI keyboard input (all channels)" />
          <Button Name="MidiRescanButton" Classes="icon" ToolTip.Tip="Look for MIDI keyboards again (after plugging one in)" AutomationProperties.Name="Look for MIDI keyboards">
            <Path Data="M 13,4 A 6,6 0 1 0 14,9 M 13,1 L 13,4 L 10,4" Stroke="{DynamicResource ButtonText}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" />
          </Button>
          <TextBlock Text="Zoom" Classes="toolLabel" Margin="6,0,0,0" />
          <Button Name="ZoomOutButton" Content="−" Width="28" ToolTip.Tip="Zoom out in time (G)" />
          <Button Name="ZoomInButton" Content="+" Width="28" ToolTip.Tip="Zoom in in time (H)" />
          <Button Name="RowsOutButton" Content="↕−" ToolTip.Tip="Smaller key rows (Ctrl+Shift+wheel)" />
          <Button Name="RowsInButton" Content="↕+" ToolTip.Tip="Larger key rows (Ctrl+Shift+wheel)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Info bar: the selected notes, as Hitsound mode's selection bar shows the selected hits. -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="info" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
      <StackPanel Orientation="Horizontal">
        <StackPanel Classes="field" MinWidth="130">
          <TextBlock Text="SELECTION" Classes="fieldLabel" />
          <TextBlock Name="InfoSelection" Text="No notes" Classes="fieldValue" />
        </StackPanel>
        <StackPanel Classes="field" MinWidth="150">
          <TextBlock Text="START · ms" Classes="fieldLabel" />
          <TextBlock Name="InfoStart" Text="—" Classes="fieldValue" />
        </StackPanel>
        <StackPanel Classes="field" MinWidth="80">
          <TextBlock Text="PITCH" Classes="fieldLabel" />
          <TextBlock Name="InfoPitch" Text="—" Classes="fieldValue" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="VELOCITY · 1–127" Classes="fieldLabel" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox Name="VelocityValueBox" Width="60" Watermark="1-127" ToolTip.Tip="Velocity for the selected notes. Enter or Apply commits it." />
            <Button Name="VelocityApplyButton" Content="Apply" Focusable="True" ToolTip.Tip="Apply to the selected notes (one undo step)" />
          </StackPanel>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="VALUE EDIT" Classes="fieldLabel" />
          <ComboBox Name="VelocityModeBox" Width="100" Focusable="True" ToolTip.Tip="Relative moves every selected velocity by the value; Set all gives them that value" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="INSERT VELOCITY" Classes="fieldLabel" />
          <NumericUpDown Name="InsertVelocityBox" Minimum="1" Maximum="127" Increment="1" Value="100" FormatString="0" Width="104" ToolTip.Tip="The velocity of drawn notes (1–127)" />
        </StackPanel>
        <StackPanel Classes="field" MinWidth="200">
          <TextBlock Text="GAMEPLAY OBJECT" Classes="fieldLabel" />
          <TextBlock Name="InfoObject" Text="—" Classes="fieldValue" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="SONG" Classes="fieldLabel" VerticalAlignment="Center" />
          <Slider Name="SongVolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100" Focusable="True" VerticalAlignment="Center" ToolTip.Tip="Song volume (the tracks unchanged)" />
          <ToggleButton Name="SongMuteButton" Content="Mute" ToolTip.Tip="Mute the song. Soloing a track also silences it." />
          <TextBlock Text="Offset" Classes="toolLabel" />
          <TextBox Name="SongOffsetBox" Width="60" Text="0" VerticalAlignment="Center" ToolTip.Tip="Song offset in ms for this project: positive plays the song later. Enter applies. Preferences → Song offset for all maps is added too." />
          <TextBlock Text="ms" Classes="fieldLabel" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Tracks: the inspector side of the key editor. -->
    <Border Grid.Row="2" Background="{DynamicResource PaneTitle}" Padding="10,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="sectionLabel" Text="TRACKS" Margin="0,0,0,6" />
        <Border DockPanel.Dock="Top" Padding="8,5" CornerRadius="4" Background="{DynamicResource ButtonBg}" Margin="0,0,0,4">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ToggleButton Name="SongRowMute" Content="M" Width="24" Height="22" MinHeight="22" Padding="0" FontSize="11" HorizontalContentAlignment="Center" ToolTip.Tip="Mute the song" />
              <ToggleButton Name="SongRowSolo" Content="S" Width="24" Height="22" MinHeight="22" Padding="0" FontSize="11" HorizontalContentAlignment="Center" ToolTip.Tip="Solo the song: hear it without the tracks" />
            </StackPanel>
            <TextBlock Text="Song audio" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="AddTrackButton" Content="+ Track" ToolTip.Tip="Add an instrument track with the bundled piano" />
            <Button Name="RenameTrackButton" Content="Rename…" ToolTip.Tip="Rename the selected track" />
            <Button Name="DeleteTrackButton" Content="Delete" ToolTip.Tip="Delete the selected track. Undo brings it back with its notes." />
          </StackPanel>
          <TextBlock Name="InstrumentText" Classes="caption" HorizontalAlignment="Left" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Name="InstrumentButton" Content="Instrument…" Margin="0,0,6,4" ToolTip.Tip="Play the selected track with the bundled piano or a VST3 instrument. Its notes stay as they are (undoable)." />
            <Button Name="EditorButton" Content="Open editor" Margin="0,0,6,4" ToolTip.Tip="Show the VST3 instrument's own window" />
            <Button Name="FixButton" Margin="0,0,6,4" IsVisible="False" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="caption" Text="Volume (dB)" VerticalAlignment="Center" />
            <NumericUpDown Name="VolumeBox" Minimum="-60" Maximum="12" Increment="1" FormatString="0.#" Width="110"
                           ToolTip.Tip="The selected track's level in the generated WAVs (osu! has one volume per object, so the balance between tracks is baked in)" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="TrackList" Spacing="4" />
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Grid.Column="1" Background="#1c1c1e" />
    <app:PianoRollView Grid.Row="2" Grid.Column="2" Name="Roll" />

    <!-- Transport, as in Hitsound mode: locators, buttons, Cycle and playback options; the clock; speed; global volume. -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="transportBar" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Name="GoLeftButton" Content="L ◀" FontSize="11" Padding="5,0" Height="28" MinHeight="28" Focusable="True" ToolTip.Tip="Go to the left locator (Ctrl+click the ruler sets it)" />
              <TextBox Name="LeftLocatorBox" Width="74" Height="28" MinHeight="28" FontSize="11" Padding="5,0" VerticalContentAlignment="Center" Watermark="L · ms" ToolTip.Tip="Left locator in ms: type a time and press Enter" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Name="GoRightButton" Content="R ◀" FontSize="11" Padding="5,0" Height="28" MinHeight="28" Focusable="True" ToolTip.Tip="Go to the right locator (Alt+click the ruler sets it)" />
              <TextBox Name="RightLocatorBox" Width="74" Height="28" MinHeight="28" FontSize="11" Padding="5,0" VerticalContentAlignment="Center" Watermark="R · ms" ToolTip.Tip="Right locator in ms: type a time and press Enter" />
            </StackPanel>
          </StackPanel>
          <Button Name="StartButton" Classes="transport" ToolTip.Tip="Go to start (Home)" AutomationProperties.Name="Go to start">
            <Path Data="M 0,0 L 2,0 L 2,14 L 0,14 Z M 13,0 L 3,7 L 13,14 Z" Fill="{DynamicResource ButtonText}" Width="12" Height="13" Stretch="Uniform" />
          </Button>
          <Button Name="StopButton" Classes="transport" ToolTip.Tip="Stop; press again to go to the start" AutomationProperties.Name="Stop"><app:SkinIcon Glyph="Stop" /></Button>
          <Button Name="PlayButton" Classes="transport" Foreground="{DynamicResource PlayIcon}" ToolTip.Tip="Play / stop (Space): the song and the audible tracks' notes" AutomationProperties.Name="Play or stop"><app:SkinIcon Name="PlayGlyph" Glyph="Play" /></Button>
          <ToggleButton Name="RecordButton" Classes="transport" ToolTip.Tip="Record (Numpad *): from the playhead into the selected track, from your MIDI keyboard. Notes starting in the recorded range are replaced; Space or Record stops." AutomationProperties.Name="Record">
            <Ellipse Width="12" Height="12" Fill="#e5484d" />
          </ToggleButton>
          <ToggleButton Name="LoopButton" Classes="transport wide" ToolTip.Tip="Cycle between the L and R locators (L or /). Ctrl+click the ruler sets L, Alt+click sets R." AutomationProperties.Name="Loop">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <app:SkinIcon Glyph="Cycle" />
              <TextBlock Text="Cycle" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
            <ToggleButton Name="ReturnOnStopButton" Content="Return on stop" Height="28" MinHeight="28" Padding="6,0" FontSize="11" ToolTip.Tip="When stopping playback, return to where playback started" />
            <ToggleButton Name="FollowPlaybackButton" Content="Follow playback" IsChecked="True" Height="28" MinHeight="28" Padding="6,0" FontSize="11" ToolTip.Tip="Scroll the editing view to follow the playhead during playback" />
          </StackPanel>
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
            <ToggleButton Name="CountInToggle" Content="Count-in" IsChecked="True" Height="28" MinHeight="28" Padding="6,0" FontSize="11" ToolTip.Tip="One bar of clicks before recording starts (shorter at the very start of the song)" />
            <ToggleButton Name="MetronomeToggle" Content="Click" IsChecked="True" Height="28" MinHeight="28" Padding="6,0" FontSize="11" ToolTip.Tip="Metronome while recording: the bar's first beat is higher" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,2" Margin="16,0,0,0" Height="44" VerticalAlignment="Center">
          <Grid ColumnDefinitions="102,88,54,84" VerticalAlignment="Center">
            <StackPanel Grid.Column="0"><TextBlock Name="TimeText" Classes="lcd" Text="0:00.000" /><TextBlock Classes="caption" Text="TIME" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Name="BarText" Classes="lcd" Text="1.1.1" /><TextBlock Classes="caption" Text="BAR · BEAT · TICK" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Name="BpmText" Classes="lcd" Text="—" /><TextBlock Classes="caption" Text="TEMPO" /></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Name="MeterText" Classes="lcd" Text="4/4 /4" /><TextBlock Classes="caption" Text="SIGNATURE · SNAP" /></StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Name="SpeedPanel" Orientation="Horizontal" Spacing="2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="Playback speed: the pitch stays the same" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0"
                    ToolTip.Tip="Global volume: the song, tracks and previews together (20–100 %), shared with Hitsound mode">
          <TextBlock Text="Global volume" Classes="toolLabel" />
          <Slider Name="GlobalVolumeSlider" Width="88" Minimum="20" Maximum="100" Value="20" Focusable="True" VerticalAlignment="Center" />
          <TextBlock Name="GlobalVolumeText" Text="20%" Classes="fieldValue" Width="36" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer, as in Hitsound mode: what is being edited, then the latest message until dismissed. -->
    <Border Grid.Row="4" Grid.ColumnSpan="3" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
      <StackPanel Margin="12,6" Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="Editing:" Foreground="{DynamicResource ButtonText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Name="ProjectPathText" Foreground="{DynamicResource LcdCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Name="ProjectFolderButton" Content="Open project folder" Margin="8,0,0,0" ToolTip.Tip="Show the Keysound project folder (its reference copy and Generate's output) in Explorer" />
        </Grid>
        <Grid Name="MessageRow" ColumnDefinitions="*,Auto" IsVisible="False">
          <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource ButtonText}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="DismissButton" Content="Dismiss" Margin="8,0,0,0" VerticalAlignment="Top" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
