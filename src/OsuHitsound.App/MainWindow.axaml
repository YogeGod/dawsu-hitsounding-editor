<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:OsuHitsound.App"
        x:Class="OsuHitsound.App.MainWindow"
        Title="dawsu! Hitsound"
        Icon="/Assets/dawsu.ico"
        Width="1600" Height="900" MinWidth="900" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1"
        RequestedThemeVariant="Dark">
  <!-- One bar on top (UI refresh, 2026-11-13): the menu bar is also the window's title bar and carries Save and the
       window buttons (WindowButtons), so the editor gets the old title strip's height back. -->
  <DockPanel Name="WindowRoot">

  <Grid Name="Root" RowDefinitions="44,Auto,20,*,160,Auto,Auto" ColumnDefinitions="224,4,208,4,*">
    <!-- 1. Header: logo, title, menus; map name and settings on the right. Open and Save sit in the ribbon (in Keysound
         mode, the key editor's own ribbon). -->
    <Border Grid.Row="0" Grid.ColumnSpan="5" Name="TitleBar" Classes="header" BorderThickness="0,0,0,1">
      <ScrollViewer Name="TitleBarScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
      <Grid Name="TitleBarContent" MinWidth="1080" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0,0,0">
        <TextBlock Text="dawsu!" Classes="appTitle" FontSize="16" />
        <TextBlock Name="AppTitle" Grid.Column="1" Text="" Classes="appTitle" Margin="0,0,16,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="HomeButton" Classes="icon flat" AutomationProperties.Name="Start screen"
                  ToolTip.Tip="Back to the start screen (asks to save first)"><app:AppIcon Glyph="House" /></Button>
          <!-- Hitsound menus (menu layout D, decided 2026-11-12): every item has an icon and a shortcut chip, on/off
               settings show as switches, and choices are rows of buttons instead of submenus. Icons and switches are
               applied from one table in MainWindow.MenuLook.cs. -->
          <Menu Name="HeaderMenu" VerticalAlignment="Center" Margin="4,0,0,0">
            <MenuItem Header="File" Name="FileMenu">
              <MenuItem Name="StartScreenItem" Header="Start screen" />
              <MenuItem Name="OpenItem" Header="Open map…" />
              <MenuItem Name="OpenFromOsuItem" Header="Open map from osu!" />
              <MenuItem Name="ImportOszItem" Header="Import .osz…" />
              <MenuItem Name="RecentItem" Header="Recent maps" />
              <MenuItem Name="OpenFolderItem" Header="Open map folder" />
              <MenuItem Name="OpenHitsoundFolderItem" Header="Open hitsound folder" />
              <Separator />
              <MenuItem Name="SaveItem" Header="Save .osu" />
              <MenuItem Name="RevertItem" Header="Revert to last saved…" IsEnabled="False" />
              <MenuItem Name="NewDiffItem" Header="New hitsound diff…" />
              <MenuItem Name="GenerateFileItem" Header="Generate hitsound diff…" />
              <MenuItem Name="ReviewOutputItem" Header="Review output…" />
              <Separator />
              <MenuItem Name="ReloadOsuItem" Header="Reload osu!'s editor after Save" ToggleType="CheckBox" />
              <MenuItem Name="ExportStyleRow" Classes="choiceRow" StaysOpenOnClick="True">
                <MenuItem.Header>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Export style" />
                    <StackPanel Classes="segment">
                      <ToggleButton Name="GreenLinesChoice" Content="Green lines" ToolTip.Tip="Default: volumes and samples change on green lines" />
                      <ToggleButton Name="PerObjectChoice" Content="Per-object" ToolTip.Tip="Per-object settings; sliders still use green lines" />
                    </StackPanel>
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Name="KeepMixedIndexesItem" Header="Allow mixed sample indexes on one object" ToggleType="CheckBox"
                        ToolTip.Tip="Several sample indexes or sets on one object: Save writes combined copies" />
              <MenuItem Name="MissingWarningsItem" Header="Warn: no hit object here" ToggleType="CheckBox" />
              <MenuItem Name="ConflictWarningsItem" Header="Warn: save/export problems" ToggleType="CheckBox" />
              <MenuItem Name="PreferencesItem" Header="Preferences…" />
              <Separator />
              <MenuItem Name="QuickStartItem" Header="Quick start" />
              <MenuItem Name="TutorialItem" Header="Full interface tour" />
              <MenuItem Name="CheckUpdatesItem" Header="Check for updates…" />
            </MenuItem>
            <MenuItem Header="Edit" Name="EditMenu">
              <MenuItem Name="UndoItem" Header="Undo" />
              <MenuItem Name="RedoItem" Header="Redo" />
              <Separator />
              <MenuItem Name="CutItem" Header="Cut" />
              <MenuItem Name="CopyItem" Header="Copy" />
              <MenuItem Name="PasteItem" Header="Paste at playhead" />
              <MenuItem Name="DuplicateItem" Header="Duplicate" />
              <MenuItem Name="DeleteItem" Header="Delete" />
              <MenuItem Name="SelectAllItem" Header="Select all" />
              <Separator />
              <MenuItem Name="QuantizeItem" Header="Quantize…" />
              <MenuItem Name="RepeatItem" Header="Repeat…" />
              <MenuItem Name="EditRangeItem" Header="Edit range…" />
              <MenuItem Name="ScaleVolumeItem" Header="Scale by volume…" />
              <MenuItem Name="ProtectHitnormalsItem" Header="Protect hitnormals from deletion" ToggleType="CheckBox"
                        ToolTip.Tip="Keep hitnormal sounds when deleting, cutting, erasing or clearing a range in the Hitsound editor. Turn off to remove them intentionally." />
              <Separator />
              <MenuItem Name="DrumAutoFillItem" Header="Drum hit detection…" />
            </MenuItem>
            <MenuItem Header="Playback" Name="PlaybackMenu">
              <MenuItem Name="DrumVstItem" Header="Drums VST…" />
              <MenuItem Name="DrumKitMapPlaybackItem" Header="Map lanes from drum instrument…" />
              <Separator />
              <MenuItem Name="StartFromRow" Classes="choiceRow" StaysOpenOnClick="True">
                <MenuItem.Header>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Start playing from" />
                    <StackPanel Classes="segment">
                      <ToggleButton Name="StartCursorChoice" Content="Cursor" IsChecked="True" />
                      <ToggleButton Name="StartLeftChoice" Content="Left locator" />
                      <ToggleButton Name="StartSelectionChoice" Content="Selection" />
                      <ToggleButton Name="StartSelectionOrLeftChoice" Content="Selection, else L" ToolTip.Tip="The selection's start, or the left locator when nothing is selected" />
                    </StackPanel>
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Name="ReturnOnStopItem" Header="Return on stop" ToggleType="CheckBox" />
              <MenuItem Name="FollowItem" Header="Follow playback" ToggleType="CheckBox" IsChecked="True" />
              <MenuItem Name="SpeedRow" Classes="choiceRow" StaysOpenOnClick="True">
                <MenuItem.Header>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Speed (pitch stays the same)" />
                    <StackPanel Name="SpeedMenuPanel" Classes="segment" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="Map" Name="MapMenu">
              <MenuItem Name="AddLaneItem" Header="Add lane" />
              <MenuItem Name="FilterLanesItem" Header="Filter lanes" />
              <Separator />
              <MenuItem Name="GenerateItem" Header="Generate hitsound diff…" />
              <MenuItem Name="CopyHitsoundsItem" Header="Copy hitsounds…" />
              <MenuItem Name="CleanGreenLinesItem" Header="Clean up green lines…" />
              <Separator />
              <MenuItem Name="OpenBackupsItem" Header="Open backups folder" />
            </MenuItem>
            <MenuItem Header="View" Name="ViewMenu">
              <MenuItem Name="ZoomInItem" Header="Zoom in" />
              <MenuItem Name="ZoomOutItem" Header="Zoom out" />
              <MenuItem Name="CollapseAllItem" Header="Collapse sample layers" />
              <Separator />
              <MenuItem Name="ObjectLinesItem" Header="Object lines" ToggleType="CheckBox" IsChecked="{Binding #ObjectLinesToggle.IsChecked, Mode=TwoWay}" />
              <MenuItem Name="UsedLanesItem" Header="Only lanes with hits" ToggleType="CheckBox" IsChecked="{Binding #UsedLanesToggle.IsChecked, Mode=TwoWay}" />
              <MenuItem Name="InspectorPanelItem" Header="Inspector panel" ToggleType="CheckBox" />
              <MenuItem Name="BrowserPanelItem" Header="File browser" ToggleType="CheckBox" />
              <MenuItem Name="HistoryPanelItem" Header="History" ToggleType="CheckBox" />
              <MenuItem Name="SoundSetsPanelItem" Header="Sound sets" ToggleType="CheckBox" />
              <Separator />
              <MenuItem Name="RangeToolItem" Header="Range selection tool" />
              <MenuItem Name="TimeSignaturesItem" Header="Time signatures…" />
              <MenuItem Name="InspectorItem" Header="UI inspector" />
              <MenuItem Name="HelpItem" Header="Shortcuts and help" />
            </MenuItem>
          </Menu>
          <!-- Keysound mode's menus: the Hitsound menus' places and look (icons, shortcut chips, switches, rows of choices),
               with the key editor's commands. Each item's Tag names its command: "ks:" for the key editor's own. -->
          <Menu Name="KeysoundMenu" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="False">
            <MenuItem Header="File" Name="KsFileMenu">
              <MenuItem Name="KsStartScreenItem" Header="Start screen" Tag="startScreen" />
              <MenuItem Name="KsOpenItem" Header="Open…" Tag="open" />
              <MenuItem Name="KsSaveItem" Header="Save project" Tag="save" />
              <MenuItem Name="KsCloseItem" Header="Close project" Tag="ks:close" />
              <Separator />
              <MenuItem Name="KsImportMidiItem" Header="Import MIDI…" Tag="ks:importMidi" />
              <MenuItem Name="KsGenerateItem" Header="Generate keysounds…" Tag="ks:generate" />
              <MenuItem Name="KsProjectFolderItem" Header="Open project folder" Tag="ks:projectFolder" />
              <Separator />
              <MenuItem Name="KsPreferencesItem" Header="Preferences…" Tag="preferences" />
              <Separator />
              <MenuItem Name="KsCheckUpdatesItem" Header="Check for updates…" Tag="updates" />
            </MenuItem>
            <MenuItem Header="Edit" Name="KsEditMenu">
              <MenuItem Name="KsUndoItem" Header="Undo" Tag="ks:undo" />
              <MenuItem Name="KsRedoItem" Header="Redo" Tag="ks:redo" />
              <Separator />
              <MenuItem Name="KsCutItem" Header="Cut" Tag="ks:cut" />
              <MenuItem Name="KsCopyItem" Header="Copy" Tag="ks:copy" />
              <MenuItem Name="KsPasteItem" Header="Paste at playhead" Tag="ks:paste" />
              <MenuItem Name="KsDuplicateItem" Header="Duplicate" Tag="ks:duplicate" />
              <MenuItem Name="KsDeleteItem" Header="Delete" Tag="ks:delete" />
              <MenuItem Name="KsSelectAllItem" Header="Select all" Tag="ks:selectAll" />
              <Separator />
              <MenuItem Name="KsQuantizeItem" Header="Quantize…" Tag="ks:quantizeDialog" />
              <MenuItem Name="KsRepeatItem" Header="Repeat…" Tag="ks:repeat" />
              <MenuItem Name="KsEditRangeItem" Header="Edit range…" Tag="ks:editRange" />
              <MenuItem Name="KsScaleVelocityItem" Header="Scale by velocity…" Tag="ks:scaleByVolume" />
              <MenuItem Name="KsSyncItem" Header="Sync to gameplay objects…" Tag="ks:sync" />
            </MenuItem>
            <MenuItem Header="Playback" Name="KsPlaybackMenu">
              <MenuItem Name="KsStartFromRow" Classes="choiceRow" StaysOpenOnClick="True">
                <MenuItem.Header>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Start playing from" />
                    <StackPanel Classes="segment">
                      <ToggleButton Name="KsStartCursorChoice" Content="Cursor" IsChecked="True" />
                      <ToggleButton Name="KsStartLeftChoice" Content="Left locator" />
                      <ToggleButton Name="KsStartSelectionChoice" Content="Selection" />
                      <ToggleButton Name="KsStartSelectionOrLeftChoice" Content="Selection, else L" ToolTip.Tip="The selection's start, or the left locator when nothing is selected" />
                    </StackPanel>
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Name="KsReturnOnStopItem" Header="Return on stop" Tag="ks:returnOnStop" ToggleType="CheckBox" />
              <MenuItem Name="KsFollowItem" Header="Follow playback" Tag="ks:follow" ToggleType="CheckBox" />
            </MenuItem>
            <MenuItem Header="Track" Name="KsTrackMenu">
              <MenuItem Name="KsAddTrackItem" Header="Add track" Tag="ks:addTrack" />
              <MenuItem Name="KsRenameTrackItem" Header="Rename track…" Tag="ks:renameTrack" />
              <MenuItem Name="KsDeleteTrackItem" Header="Delete track" Tag="ks:deleteTrack" />
              <Separator />
              <MenuItem Name="KsInstrumentItem" Header="Instrument…" Tag="ks:instrument" />
              <MenuItem Name="KsInstrumentEditorItem" Header="Open instrument editor" Tag="ks:instrumentEditor" />
            </MenuItem>
            <MenuItem Header="View" Name="KsViewMenu">
              <MenuItem Name="KsZoomInItem" Header="Zoom in" Tag="ks:zoomIn" />
              <MenuItem Name="KsZoomOutItem" Header="Zoom out" Tag="ks:zoomOut" />
              <Separator />
              <MenuItem Name="KsObjectLinesItem" Header="Object lines" Tag="ks:objectLines" ToggleType="CheckBox" />
              <MenuItem Name="KsGhostsItem" Header="Ghost notes" Tag="ks:ghosts" ToggleType="CheckBox" />
              <MenuItem Name="KsInspectorPanelItem" Header="Inspector panel" Tag="ks:inspector" ToggleType="CheckBox" />
              <MenuItem Name="KsControllerItem" Header="Velocity controller" Tag="ks:controller" ToggleType="CheckBox" />
              <Separator />
              <MenuItem Name="KsRangeToolItem" Header="Range selection tool" Tag="ks:rangeTool" />
              <MenuItem Name="KsUiInspectorItem" Header="UI inspector" Tag="inspector" />
              <MenuItem Name="KsHelpItem" Header="Shortcuts and help" Tag="help" />
            </MenuItem>
          </Menu>
        </StackPanel>
        <!-- The open file as a chip: a dot while there are unsaved changes, the name, then the mode. FileTitle keeps the
             whole text ("name — Hitsounds") for the code that sets and reads it; the chip shows its two parts. -->
        <Border Grid.Column="3" Name="TitleChip" Classes="titleChip" HorizontalAlignment="Center" Margin="16,0">
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Name="TitleDot" Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource ButtonText}" VerticalAlignment="Center" IsVisible="False" />
            <Border DockPanel.Dock="Right" Name="TitleModePill" Classes="modePill" Margin="8,0,0,0" IsVisible="False"><TextBlock Name="TitleMode" /></Border>
            <TextBlock DockPanel.Dock="Right" Name="FileTitle" Text="No map open" IsVisible="False" />
            <TextBlock Name="TitleName" Classes="projectName" Text="No map open" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
          <Button Name="UpdateButton" Classes="flat icon" IsVisible="False" AutomationProperties.Name="Update dawsu!">
            <app:AppIcon Glyph="Download" Foreground="{DynamicResource Brand}" />
          </Button>
          <Button Name="WorkflowStatusButton" Classes="flat icon" IsVisible="False" AutomationProperties.Name="Operation details">
            <app:AppIcon Name="WorkflowStatusIcon" Glyph="Info" />
          </Button>
          <Button Name="PreferencesButton" Classes="flat icon" AutomationProperties.Name="Preferences" ToolTip.Tip="Preferences: Songs folder, audio output, keys and colours (Ctrl+,)"><app:AppIcon Glyph="Settings" /></Button>
          <Button Name="HelpButton" Classes="flat icon" AutomationProperties.Name="Shortcuts and help" ToolTip.Tip="Every shortcut and mouse action, with search (F1)"><app:AppIcon Glyph="CircleHelp" /></Button>
          <!-- Save .osu: the badge counts what Save can't write as drawn; with problems, a click lists them first. -->
          <Button Name="SaveButton" Classes="primary titleSave" Margin="8,0,0,0" AutomationProperties.Name="Save .osu"
                  ToolTip.Tip="Save the .osu (Ctrl+S). A backup of the previous version is kept outside the mapset.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <app:AppIcon Glyph="OsuSave" Size="15" />
              <TextBlock Name="SaveLabel" Text="Save .osu" VerticalAlignment="Center" />
              <Border Name="SaveBadge" Classes="saveBadge" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <app:AppIcon Glyph="TriangleAlert" Size="11" />
                  <TextBlock Name="SaveBadgeText" Text="0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
            <FlyoutBase.AttachedFlyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Name="SaveCheckPanel" Width="340" Spacing="8">
                  <TextBlock Text="Before you save" Classes="sectionLabel" />
                  <StackPanel Name="SaveCheckList" Spacing="6" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Name="SaveCheckShowButton" Content="Show first problem" ToolTip.Tip="Select the hits at the next problem and move the playhead there" />
                    <Button Name="SaveContinueButton" Classes="primary" Content="Continue to Save" ToolTip.Tip="Run Save .osu as usual: it asks before leaving out hits with no object, and refuses what it can't write" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </FlyoutBase.AttachedFlyout>
          </Button>
          <app:WindowButtons Name="WindowBar" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- 2. Ribbon (UI refresh, 2026-11-13): tiles with the icon over its label, in groups. Secondary labels, then all
         labels hide as the window narrows (UpdateRibbonFit). Save is in the title bar; Fit sits by the time zoom, the
         lane switches by the lane filter, and the volume panel folds from its own header. -->
    <Border Grid.Row="1" Grid.ColumnSpan="5" Name="ControlBar" Classes="toolbar" BorderThickness="0,0,0,1">
      <Grid Name="ControlBarContent" ColumnDefinitions="*,Auto" Margin="6,5">
        <StackPanel Name="RibbonGroups" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
          <StackPanel Classes="ribbonGroup">
            <Button Name="OpenButton" Classes="ribbon" AutomationProperties.Name="Open a map" ToolTip.Tip="Open a map (Ctrl+O)">
              <StackPanel><app:AppIcon Glyph="OsuOpen" /><TextBlock Classes="ribbonText secondary" Text="Open" /></StackPanel>
            </Button>
            <ToggleButton Name="HsModeButton" Classes="ribbon" IsEnabled="False" AutomationProperties.Name="HS mode"
                          ToolTip.Tip="Open an empty difficulty or one named HS / hitsounds to create circles as you place sounds.">
              <StackPanel><app:AppIcon Glyph="OsuHsMode" /><TextBlock Classes="ribbonText" Text="HS mode" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <Button Name="UndoButton" Classes="ribbon" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
              <StackPanel><app:AppIcon Glyph="OsuUndo" /><TextBlock Classes="ribbonText secondary" Text="Undo" /></StackPanel>
            </Button>
            <Button Name="RedoButton" Classes="ribbon" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
              <StackPanel><app:AppIcon Glyph="OsuRedo" /><TextBlock Classes="ribbonText secondary" Text="Redo" /></StackPanel>
            </Button>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="SelectTool" Classes="tool ribbon" IsChecked="True" ToolTip.Tip="Select and move (1). Click, Ctrl/Shift+click, drag a box; drag hits to move them." AutomationProperties.Name="Select">
              <StackPanel><app:AppIcon Glyph="MousePointer2" /><TextBlock Classes="ribbonText" Text="Select" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="GrabTool" Classes="tool ribbon" ToolTip.Tip="Grab (2). Drag the canvas to pan time and lanes. Space plays or stops." AutomationProperties.Name="Grab">
              <StackPanel><app:AppIcon Glyph="Hand" /><TextBlock Classes="ribbonText" Text="Grab" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="DrawTool" Classes="tool ribbon" ToolTip.Tip="Draw (3, or hold Alt). Click or drag along a lane; starting on a hit erases instead." AutomationProperties.Name="Draw">
              <StackPanel><app:AppIcon Glyph="Drumstick" /><TextBlock Classes="ribbonText" Text="Draw" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="EraseTool" Classes="tool ribbon" ToolTip.Tip="Erase (4). Drag across hits to remove them." AutomationProperties.Name="Erase">
              <StackPanel><app:AppIcon Glyph="Eraser" /><TextBlock Classes="ribbonText" Text="Erase" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="MuteTool" Classes="tool ribbon" ToolTip.Tip="Mute (5). Click a hit to silence it while listening. Preview only: osu! cannot store a muted sound, so this is never saved." AutomationProperties.Name="Mute">
              <StackPanel><app:AppIcon Glyph="VolumeX" /><TextBlock Classes="ribbonText" Text="Mute" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <ToggleButton Name="SnapToggle" Classes="ribbon" IsChecked="True" AutomationProperties.Name="Snap" ToolTip.Tip="Snapping on / off (J)">
              <StackPanel><app:AppIcon Glyph="OsuSnap" /><TextBlock Classes="ribbonText" Text="Snap" /></StackPanel>
            </ToggleButton>
            <Panel Classes="captioned"><ComboBox Name="SnapModeBox" Classes="captioned" Width="106" Focusable="True" ToolTip.Tip="Grid: land on grid lines. Grid relative: keep the offset from the grid. Objects: snap to gameplay circles, slider nodes and spinner ends." /><TextBlock Classes="boxCaption" Text="Snap to" /></Panel>
            <Panel Classes="captioned"><ComboBox Name="SnapBox" Classes="captioned" Width="76" Focusable="True" ToolTip.Tip="Snap spacing: 2/1, 3/1 or 4/1 means every 2, 3 or 4 beats from each red timing point. Shift+1–9 selects 1/n; Alt+wheel cycles snaps." /><TextBlock Classes="boxCaption" Text="Spacing" /></Panel>
            <ToggleButton Name="ObjectLinesToggle" Classes="ribbon" AutomationProperties.Name="Gameplay-object lines" IsChecked="True" ToolTip.Tip="Vertical lines down the lanes at every circle, slider head, repeat and tail, and spinner end, whatever the snap">
              <StackPanel><app:AppIcon Glyph="OsuLines" /><TextBlock Classes="ribbonText secondary" Text="Object lines" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="TripletSnapToggle" Classes="ribbon" AutomationProperties.Name="Triplets"
                          ToolTip.Tip="Alt+wheel: on cycles 3/1, 1/1, 1/3, 1/6, 1/12; off cycles 4/1, 2/1, 1/1, 1/2, 1/4, 1/8, 1/16. The drop-down offers every spacing; Shift+number still selects 1/n.">
              <StackPanel><app:AppIcon Glyph="OsuTriplets" /><TextBlock Classes="ribbonText secondary" Text="Triplets" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="AuditionPlacementButton" Classes="ribbon" AutomationProperties.Name="Audition"
                          ToolTip.Tip="Play samples when drawing notes or moving them between lanes. Saved for all projects.">
              <StackPanel><app:AppIcon Glyph="OsuAudition" /><TextBlock Classes="ribbonText secondary" Text="Audition" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Border Classes="ribbonSep" />
          <StackPanel Classes="ribbonGroup">
            <Button Name="DrumDetectButton" Classes="ribbon" AutomationProperties.Name="Drum hit detection" ToolTip.Tip="Drum hit detection: find kick and snare hits in the song or a drum stem">
              <StackPanel><app:AppIcon Glyph="OsuDetect" /><TextBlock Classes="ribbonText" Text="Detect hits" /></StackPanel>
            </Button>
            <Button Name="DrumVstButton" Classes="ribbon" AutomationProperties.Name="Drums VST" ToolTip.Tip="Play the drum lanes through a VST instrument">
              <StackPanel><app:AppIcon Glyph="OsuVst" /><TextBlock Classes="ribbonText secondary" Text="VST" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <!-- The side panels' switches sit alone at the far right, in the panels' own left-to-right order. -->
        <StackPanel Grid.Column="1" Name="RibbonPanels" Classes="ribbonGroup" Margin="8,0,0,0">
            <ToggleButton Name="BrowserToggle" Classes="ribbon" IsChecked="{Binding #BrowserPanelItem.IsChecked, Mode=TwoWay}" ToolTip.Tip="Show the file browser on the left" AutomationProperties.Name="Sample browser">
              <StackPanel><app:AppIcon Glyph="OsuFiles" /><TextBlock Classes="ribbonText secondary" Text="Files" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="InspectorToggle" Classes="ribbon" AutomationProperties.Name="Inspector" IsChecked="True" ToolTip.Tip="Show the inspector beside the lanes: selection, active lane, bookmarks and optional panels">
              <StackPanel><app:AppIcon Glyph="OsuInspector" /><TextBlock Classes="ribbonText secondary" Text="Inspector" /></StackPanel>
            </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The inspector's Selection card: built here so the window's handlers find these controls by name, then moved
         into the inspector by SetupInspector. Hidden until then. -->
    <Panel Name="InspectorParts" IsVisible="False">
      <StackPanel Name="SelectionEditor" Spacing="6">
        <TextBlock Name="InfoSelection" Text="Nothing selected" Classes="fieldValue" />
        <TextBlock Name="SelectionHelp" Text="Select hits to change their time and volume here." TextWrapping="Wrap" FontSize="11" Opacity="0.85" />
        <StackPanel Name="SelectionFields" Spacing="6" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Start · ms" Classes="toolLabel" />
            <TextBox Grid.Column="1" Name="StartBox" Width="88" Watermark="—" ToolTip.Tip="Where the selection starts, in ms. Type a time and press Enter to move it there (several: all move together); Esc puts it back." />
          </Grid>
          <TextBlock Name="InfoStart" Text="" Classes="fieldLabel" HorizontalAlignment="Right" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBlock Text="Volume · %" Classes="toolLabel" ToolTip.Tip="Edits volumes at selected times using the chosen volume scope." />
            <TextBox Grid.Column="1" Name="VolumeValueBox" Width="52" Watermark="0-100" ToolTip.Tip="Volume at the selected times, using All lanes or Selected lanes. Enter or Apply commits the value." />
            <Button Grid.Column="2" Name="VolumeApplyButton" Content="Apply" Focusable="True" ToolTip.Tip="Apply to the chosen volume scope at the selected times." />
          </Grid>
          <StackPanel Spacing="3">
            <TextBlock Text="Change" Classes="toolLabel" />
            <ComboBox HorizontalAlignment="Left" Name="VolumeModeBox" Width="110" Focusable="True" ToolTip.Tip="Relative moves every selected volume by the value; Set all gives them that value" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="Applies to" Classes="toolLabel" />
            <ComboBox HorizontalAlignment="Left" Name="VolumeScopeBox" Width="110" ToolTip.Tip="All lanes changes every sound at the affected times. Selected lanes changes only the selected lanes." />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="Object" Classes="toolLabel" />
            <TextBlock Grid.Column="1" Name="InfoObject" Text="—" Classes="fieldValue" TextWrapping="Wrap" ToolTip.Tip="The gameplay object under the selection" />
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <Button Name="SelectionQuantizeButton" Content="Quantize…" Margin="0,0,4,4" ToolTip.Tip="Quantize the selected hits to the grid" />
            <Button Name="SelectionDuplicateButton" Content="Duplicate" Margin="0,0,4,4" ToolTip.Tip="Duplicate the selected hits (Ctrl+D)" />
            <Button Name="SelectionDeleteButton" Content="Delete" Margin="0,0,4,4" ToolTip.Tip="Delete the selected hits (Del)" />
          </WrapPanel>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Text="New hits · %" Classes="toolLabel" />
          <NumericUpDown Grid.Column="1" Name="InsertVolumeBox" Minimum="0" Maximum="100" Increment="1" FormatString="0" Width="104"
                         Watermark="Map" AutomationProperties.Name="Insert volume percent"
                         ToolTip.Tip="Volume for newly drawn hits (0–100%). Clear this field to follow the map volume. Existing hits, pasted notes and sound sets keep their volumes." />
        </Grid>
      </StackPanel>
    </Panel>

    <!-- 4. Overview strip -->
    <app:OverviewStrip Grid.Row="2" Grid.Column="4" Name="Overview" />

    <!-- Inspector (left): Selection, Bookmarks, Recent edits; the splitter resizes it -->
    <app:InspectorPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Name="Inspector" Background="{DynamicResource VolumeSide}" />
    <GridSplitter Grid.Row="2" Grid.RowSpan="3" Grid.Column="3" Name="InspectorSplitter" ResizeDirection="Columns" Background="{DynamicResource Divider}" />

    <!-- 5. Arrange area -->
    <Grid Grid.Row="3" Grid.Column="4" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <app:ArrangeView Name="Lanes" />
      <TextBox Name="LaneFilterBox" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,33,0,0" MinHeight="24" Height="24" Padding="9,0" FontSize="10.5" CornerRadius="8" VerticalContentAlignment="Center" TextAlignment="Left" Watermark="Filter samples…" />
      <!-- Lane switches, on the filter's row (placed by AlignToLaneList). -->
      <ToggleButton Name="UsedLanesToggle" Classes="laneSwitch" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True" AutomationProperties.Name="Only lanes with hits" IsChecked="False" ToolTip.Tip="Show only the lanes that have hits on them (switch off and on again to refresh the list after adding hits)" Content="Used only" />
      <ToggleButton Name="LaneDetailsToggle" Classes="laneSwitch" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True" AutomationProperties.Name="Lane info (sample indexes)" IsChecked="False" ToolTip.Tip="Show each lane's file index after its name"><app:AppIcon Glyph="Info" Size="13" /></ToggleButton>
      <Border Name="ViewSwitchBack" Classes="switchBack" HorizontalAlignment="Left" VerticalAlignment="Top" Height="28" IsHitTestVisible="False" />
      <ToggleButton Name="SamplesViewButton" Classes="viewSwitch" Width="54" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True" IsChecked="True" IsEnabled="False"
                    AutomationProperties.Name="Sample view" ToolTip.Tip="Sample view: one lane per sample">
        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"><app:AppIcon Glyph="AudioWaveform" Size="13" /><TextBlock Name="SamplesViewLabel" Text="Samples" VerticalAlignment="Center" /></StackPanel>
      </ToggleButton>
      <ToggleButton Name="DrumMapToggle" Classes="drumMap" Width="78" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True"
                    AutomationProperties.Name="Drum-map view" ToolTip.Tip="Switch Sample / Drum-map view. Right-click for Drum Map Setup." IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"><app:AppIcon Glyph="OsuSnare" Size="14" /><TextBlock Name="DrumMapLabel" Text="Drum map" VerticalAlignment="Center" /></StackPanel>
        <ToggleButton.ContextMenu><ContextMenu><MenuItem Name="DrumMapSetupItem" Header="Drum Map Setup…" /><MenuItem Name="DrumKitMapItem" Header="Map lanes from drum instrument…" /></ContextMenu></ToggleButton.ContextMenu>
      </ToggleButton>
      <!-- Scrollbars with Cubase-style zoom ends: lane height at the bottom of the vertical one, time zoom at the
           right of the horizontal one. -->
      <DockPanel Grid.Column="1" Name="VScrollColumn">
        <StackPanel Name="RowZoomPanel" DockPanel.Dock="Bottom" Classes="zoomEnd" Orientation="Vertical">
          <Button Name="RowZoomInButton" Classes="zoomStep" Content="+" AutomationProperties.Name="Taller lanes" ToolTip.Tip="Taller lanes (Ctrl+Up, or Ctrl+Shift+wheel)" />
          <Slider Name="RowHeightSlider" Classes="zoom" Orientation="Vertical" Height="64" Focusable="True" AutomationProperties.Name="Lane height" ToolTip.Tip="Lane height" />
          <Button Name="RowZoomOutButton" Classes="zoomStep" Content="−" AutomationProperties.Name="Shorter lanes" ToolTip.Tip="Shorter lanes (Ctrl+Down, or Ctrl+Shift+wheel)" />
        </StackPanel>
        <ScrollBar Name="VScroll" Orientation="Vertical" />
      </DockPanel>
      <DockPanel Grid.Row="1" Name="HScrollRow" Margin="328,0,0,0">
        <StackPanel Name="TimeZoomPanel" DockPanel.Dock="Right" Classes="zoomEnd" Orientation="Horizontal">
          <Button Name="FitButton" Classes="zoomFit" AutomationProperties.Name="Fit" ToolTip.Tip="Zoom out to the whole map">
              <StackPanel Orientation="Horizontal" Spacing="4"><app:AppIcon Glyph="OsuFit" Size="12" /><TextBlock Text="Fit" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Name="TimeZoomOutButton" Classes="zoomStep" Content="−" AutomationProperties.Name="Zoom out" ToolTip.Tip="Zoom out in time (G, or Ctrl+wheel)" />
          <Slider Name="ZoomSlider" Classes="zoom" Width="80" Minimum="0" Maximum="1" Value="0.5" Focusable="True" AutomationProperties.Name="Timeline zoom" ToolTip.Tip="Time zoom" />
          <Button Name="TimeZoomInButton" Classes="zoomStep" Content="+" AutomationProperties.Name="Zoom in" ToolTip.Tip="Zoom in on time (H, or Ctrl+wheel)" />
        </StackPanel>
        <ScrollBar Name="HScroll" Orientation="Horizontal" />
      </DockPanel>
    </Grid>

    <!-- Bottom panel (V6.39 controller): Controller tabs · ramp shape · hint; bars on the right -->
    <Border Grid.Row="4" Grid.Column="4" Name="BottomPanel" Background="{DynamicResource VolumeSide}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource PaneTitle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,0,6,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Volumes" Classes="paneTitle" Margin="0,0,8,0" />
          <RadioButton Name="VolumeTab" Classes="pilltab" Content="Volume" IsChecked="True" GroupName="bottom" Focusable="True" />
          <RadioButton Name="SavedTab" Classes="pilltab" Content="What gets saved" GroupName="bottom" Focusable="True" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
          <ToggleButton Name="RampTool" Classes="tool" ToolTip.Tip="Ramp (6). Drag in the volume lane to draw a volume ramp." AutomationProperties.Name="Ramp"><app:AppIcon Glyph="TrendingUp" /></ToggleButton>
          <TextBlock Name="VolumeScopeHint" Text="All lanes" Classes="fieldLabel" VerticalAlignment="Center" />
          <ComboBox Name="RampShapeBox" Width="110" Focusable="True" ToolTip.Tip="Shape of ramps (Shift+drag in the bars, or the Ramp tool)" />
        </StackPanel>
        <TextBlock Grid.Column="2" Name="ActiveLaneText" Classes="fieldLabel" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip.Tip="The active lane: the one touched last (highlighted in the lane list)" />
        <StackPanel Grid.Column="3" Classes="keyHint" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True"><TextBlock Text="Drag bars" /><Border Classes="keyChip"><TextBlock Text="Ctrl" /></Border><TextBlock Text="spread" /><Border Classes="keyChip"><TextBlock Text="Alt" /></Border><TextBlock Text="paint" /><Border Classes="keyChip"><TextBlock Text="Shift" /></Border><TextBlock Text="ramp" /></StackPanel>
        <ToggleButton Grid.Column="4" Name="VolumeToggle" Classes="icon fold" IsChecked="True" Margin="8,0,0,0" AutomationProperties.Name="Volume controller"
                      ToolTip.Tip="Fold or unfold the volume controller"><app:AppIcon Glyph="ChevronDown" Size="13" /></ToggleButton>
        </Grid>
        </Border>
        <Panel Name="VolumeBody">
          <app:VolumeLane Name="Volume" />
          <ScrollViewer Name="VolumeControlScroller" HorizontalAlignment="Left" Width="347" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="VolumeControls" Margin="14,8" Spacing="8">
            <TextBlock Text="Volume" FontWeight="Bold" Foreground="{DynamicResource ButtonText}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Select" Classes="toolLabel" />
              <TextBox Name="VolumeMinBox" Width="46" Watermark="min" />
              <TextBlock Text="to" Classes="toolLabel" />
              <TextBox Name="VolumeMaxBox" Width="46" Watermark="max" />
              <Button Name="VolumeSelectButton" Content="Select" Focusable="True" ToolTip.Tip="Select every hit whose moment volume is in this range" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer Name="SavedPreview" IsVisible="False" Margin="14,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Name="SavedSummary" Foreground="{DynamicResource ButtonText}" TextWrapping="Wrap" />
              <Expander Name="SavedFields" Header="Advanced: osu! fields" HorizontalAlignment="Stretch">
                <TextBlock Name="SavedText" Foreground="{DynamicResource LcdCaption}" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Name="BrowserSplitter" Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource ChromeBorder}" />
    <Border Name="BrowserHost" Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Padding="8" Background="{DynamicResource PaneTitle}" />
    <!-- Transport: primary actions left, position centered, master/song mix right. -->
    <Border Grid.Row="5" Grid.ColumnSpan="5" Name="StatusBar" Classes="transportBar" BorderThickness="0,1,0,0">
      <Grid Name="StatusBarContent" ColumnDefinitions="*,Auto,*" Margin="12,0">
        <StackPanel Name="TransportLeft" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <StackPanel Name="TransportButtons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Name="StartButton" Classes="transport" ToolTip.Tip="Go to start (Home)" AutomationProperties.Name="Go to start">
            <app:AppIcon Size="20" Glyph="OsuStart" />
          </Button>
          <Button Name="StopButton" Classes="transport" ToolTip.Tip="Stop; press again to go to the start" AutomationProperties.Name="Stop"><app:AppIcon Size="20" Glyph="OsuStop" /></Button>
          <Button Name="PlayButton" Classes="transport play" Width="42" Height="36" ToolTip.Tip="Play / stop (Space)" AutomationProperties.Name="Play or stop"><app:AppIcon Name="PlayGlyph" Glyph="OsuPlay" Size="22" /></Button>
          <ToggleButton Name="LoopButton" Classes="transport wide" ToolTip.Tip="Cycle between the L and R locators (L or /). Ctrl+click the ruler sets L, Alt+click sets R, drag in the upper ruler draws a range." AutomationProperties.Name="Loop">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <app:AppIcon Glyph="Repeat2" />
              <TextBlock Text="Cycle" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <!-- The locators open from here: typed rarely, set mostly on the ruler (Ctrl+click L, Alt+click R). -->
          <Button Name="LocatorsButton" Classes="transport" Width="32" Padding="0" AutomationProperties.Name="Locators"
                  ToolTip.Tip="Left and right locators: go to one, or type a time in ms. Ctrl+click the ruler sets L, Alt+click sets R.">
            <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
              <TextBlock Text="L/R" FontSize="10" VerticalAlignment="Center" />
              <app:AppIcon Glyph="ChevronUp" Size="9" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Name="LocatorPanel" Spacing="6">
                  <Grid ColumnDefinitions="24,80" Height="28">
                    <Button Name="GoLeftButton" Content="L" Classes="flat" Width="24" Height="28" MinHeight="28" Padding="0" FontSize="10" AutomationProperties.Name="Go to left locator" ToolTip.Tip="Go to left locator. Ctrl+click the ruler sets it." />
                    <TextBox Grid.Column="1" Name="LeftLocatorBox" Width="80" Height="28" MinHeight="28" FontSize="11" Padding="3,0" Watermark="ms" ToolTip.Tip="Left locator in ms: type a time and press Enter" />
                  </Grid>
                  <Grid ColumnDefinitions="24,80" Height="28">
                    <Button Name="GoRightButton" Content="R" Classes="flat" Width="24" Height="28" MinHeight="28" Padding="0" FontSize="10" AutomationProperties.Name="Go to right locator" ToolTip.Tip="Go to right locator. Alt+click the ruler sets it." />
                    <TextBox Grid.Column="1" Name="RightLocatorBox" Width="80" Height="28" MinHeight="28" FontSize="11" Padding="3,0" Watermark="ms" ToolTip.Tip="Right locator in ms: type a time and press Enter" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <Border Width="1" Height="20" Background="{DynamicResource ChromeBorder}" />
        <StackPanel Name="PlaybackOptionsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ToggleButton Name="ReturnOnStopButton" Classes="flat" IsChecked="{Binding #ReturnOnStopItem.IsChecked, Mode=TwoWay}" ToolTip.Tip="When stopping playback, return to where playback started" />
          <ToggleButton Name="FollowPlaybackButton" Classes="flat" IsChecked="{Binding #FollowItem.IsChecked, Mode=TwoWay}" ToolTip.Tip="Scroll the editing view to follow the playhead during playback" />
          <WrapPanel Name="SpeedPanel" Width="252" Height="28" ItemWidth="42" ItemHeight="28" VerticalAlignment="Center" AutomationProperties.Name="Playback speed" ToolTip.Tip="Playback speed: pitch stays the same" />
        </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Name="Lcd" Grid.Row="0" HorizontalAlignment="Center" Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,2" Height="44" VerticalAlignment="Center">
          <Grid Name="LcdColumns" ColumnDefinitions="96,80,48,70" VerticalAlignment="Center">
            <StackPanel Grid.Column="0"><TextBlock Name="LcdTime" Classes="lcd" Text="0:00.000" /><TextBlock Classes="caption" Text="TIME" /></StackPanel>
            <Border Grid.Column="1" Classes="lcdCell"><StackPanel><TextBlock Name="LcdBar" Classes="lcd" Text="1.1.1" /><TextBlock Classes="caption" Text="BAR · BEAT · TICK" /></StackPanel></Border>
            <Border Grid.Column="2" Classes="lcdCell"><StackPanel><TextBlock Name="LcdBpm" Classes="lcd" Text="—" /><TextBlock Classes="caption" Text="TEMPO" /></StackPanel></Border>
            <Border Grid.Column="3" Classes="lcdCell"><StackPanel><TextBlock Name="LcdMeter" Classes="lcd" Text="4/4 /16" /><TextBlock Classes="caption" Text="METER" /></StackPanel></Border>
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Name="MixControls" Width="308" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Grid Name="GlobalVolumePanel" ColumnDefinitions="44,100,30,*" ColumnSpacing="6" Height="22" ToolTip.Tip="Global volume: song, hitsounds and previews (20–100 %)">
            <TextBlock Text="Global" Classes="fieldLabel" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Name="GlobalVolumeSlider" Height="22" MinHeight="0" Width="100" Minimum="20" Maximum="100" Value="20" Focusable="True" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Name="GlobalVolumeText" Text="20%" FontSize="10" VerticalAlignment="Center" />
          </Grid>
          <Grid Name="SongControls" ColumnDefinitions="44,100,30,22,32,*" ColumnSpacing="6" Height="22">
            <TextBlock Text="Song" Classes="fieldLabel" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Name="SongVolumeSlider" Height="22" MinHeight="0" Width="100" Minimum="0" Maximum="100" Value="100" Focusable="True" VerticalAlignment="Center" ToolTip.Tip="Song volume (hitsounds unchanged)" />
            <TextBlock Grid.Column="2" Name="SongVolumeText" Text="100%" FontSize="10" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="3" Name="SongMuteButton" Width="22" Height="22" MinHeight="22" Content="Mute" ToolTip.Tip="Mute the song. Soloing a lane also silences it." />
            <TextBlock Grid.Column="4" Text="Offset" FontSize="9" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" Name="SongOffsetBox" Height="22" MinHeight="22" Padding="1,0" FontSize="10" Text="0" VerticalAlignment="Center" ToolTip.Tip="Song offset in ms: positive plays later. Enter applies. Not saved into the map." />
          </Grid>
        </StackPanel>
        <TextBlock Name="StatusLeft" IsVisible="False" />
        <TextBlock Name="StatusRight" IsVisible="False" />
      </Grid>
    </Border>

    <!-- The start screen: under the title bar, over the empty editor, until a map opens -->
    <app:KeysoundEditor Name="Keys" Grid.Row="1" Grid.RowSpan="6" Grid.ColumnSpan="5" ZIndex="40" IsVisible="False" />
    <app:StartScreen Name="Start" Grid.Row="1" Grid.RowSpan="6" Grid.ColumnSpan="5" ZIndex="50" IsVisible="False" />
    <!-- The tutorial: over everything, hidden until it runs -->
    <app:TutorialOverlay Name="Tutorial" Grid.RowSpan="7" Grid.ColumnSpan="5" ZIndex="100" />
  </Grid>
  </DockPanel>
</Window>
