<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:OsuHitsound.App"
        x:Class="OsuHitsound.App.MainWindow"
        Title="osu! Hitsound Editor"
        Width="1600" Height="900" MinWidth="900" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1"
        RequestedThemeVariant="Dark">
  <!-- The window's own title bar (WindowTitleBar) above the editor. -->
  <DockPanel Name="WindowRoot">
  <app:WindowTitleBar Name="WindowBar" DockPanel.Dock="Top" />

  <Grid Name="Root" RowDefinitions="44,46,46,20,*,160,56,Auto" ColumnDefinitions="280,4,250,4,*">
    <!-- 1. Header (V6.39: logo, title, file buttons, menus; map name and settings on the right) -->
    <Border Grid.Row="0" Grid.ColumnSpan="5" Name="TitleBar" Classes="header" BorderThickness="0,0,0,1">
      <ScrollViewer Name="TitleBarScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid Name="TitleBarContent" MinWidth="1080" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
        <Border Classes="logo" VerticalAlignment="Center"><TextBlock Text="hs" /></Border>
        <TextBlock Name="AppTitle" Grid.Column="1" Text="osu! hitsound editor" Classes="appTitle" Margin="8,0,16,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="OpenButton" Classes="flat" Content="Open…" ToolTip.Tip="Open a map (Ctrl+O)" />
          <Button Name="SaveButton" Classes="primary" Content="Save .osu" ToolTip.Tip="Save the .osu (Ctrl+S). A backup of the previous version is kept outside the mapset." />
          <ToggleButton Name="HsModeButton" Classes="wide" Content="HS mode" IsEnabled="False"
                        ToolTip.Tip="Open an empty difficulty or one named HS / hitsounds to create circles as you place sounds." />
          <Menu Name="HeaderMenu" VerticalAlignment="Center" Margin="4,0,0,0">
            <MenuItem Header="File">
              <MenuItem Name="OpenItem" Header="Open…" />
              <MenuItem Name="ImportOszItem" Header="Import .osz…" />
              <MenuItem Name="OpenFolderItem" Header="Open map folder" />
              <MenuItem Name="OpenHitsoundFolderItem" Header="Open hitsound folder" />
              <MenuItem Name="NewDiffItem" Header="New hitsound diff…" />
              <MenuItem Name="RecentItem" Header="Recent maps" />
              <MenuItem Name="SaveItem" Header="Save" />
              <MenuItem Name="RevertItem" Header="Revert to last saved…" IsEnabled="False" />
              <Separator />
              <MenuItem Name="GenerateFileItem" Header="Generate hitsound diff…" />
              <MenuItem Name="ReviewOutputItem" Header="Review output…" />
              <MenuItem Header="Export settings">
                <MenuItem Name="GreenLinesItem" Header="Green lines (default)" ToggleType="Radio" GroupName="exportStyle" />
                <MenuItem Name="PerObjectItem" Header="Per-object settings (sliders use green lines)" ToggleType="Radio" GroupName="exportStyle" />
                <Separator />
                <MenuItem Name="KeepMixedIndexesItem" Header="Allow mixed sample indexes and sets on one object (Save writes combined copies)" ToggleType="CheckBox" />
              </MenuItem>
              <MenuItem Header="Warning markers">
                <MenuItem Name="MissingWarningsItem" Header="No hit object here" ToggleType="CheckBox" />
                <MenuItem Name="ConflictWarningsItem" Header="Save/export problems" ToggleType="CheckBox" />
              </MenuItem>
              <Separator />
              <MenuItem Name="PreferencesItem" Header="Preferences…" />
              <Separator />
              <MenuItem Name="QuickStartItem" Header="Quick start" />
              <MenuItem Name="TutorialItem" Header="Full interface tour" />
            </MenuItem>
            <MenuItem Header="Edit">
              <MenuItem Name="UndoItem" Header="Undo" />
              <MenuItem Name="RedoItem" Header="Redo" />
              <Separator />
              <MenuItem Name="CutItem" Header="Cut" />
              <MenuItem Name="CopyItem" Header="Copy" />
              <MenuItem Name="PasteItem" Header="Paste at playhead" />
              <MenuItem Name="DuplicateItem" Header="Duplicate" />
              <MenuItem Name="DeleteItem" Header="Delete" />
              <Separator />
              <MenuItem Name="SelectAllItem" Header="Select all" />
              <Separator />
              <MenuItem Name="QuantizeItem" Header="Quantize…" />
              <MenuItem Name="RepeatItem" Header="Repeat…" />
              <MenuItem Name="EditRangeItem" Header="Edit range…" />
              <MenuItem Name="ScaleVolumeItem" Header="Scale by volume…" />
            </MenuItem>
            <MenuItem Header="Playback">
              <MenuItem Name="DrumVstItem" Header="Drums VST…" />
              <Separator />
              <MenuItem Header="Start from">
                <MenuItem Name="StartCursorItem" Header="Cursor" ToggleType="Radio" GroupName="start" IsChecked="True" />
                <MenuItem Name="StartLeftItem" Header="Left locator" ToggleType="Radio" GroupName="start" />
                <MenuItem Name="StartSelectionItem" Header="Selection" ToggleType="Radio" GroupName="start" />
                <MenuItem Name="StartSelectionOrLeftItem" Header="Selection, else left locator" ToggleType="Radio" GroupName="start" />
              </MenuItem>
              <MenuItem Name="ReturnOnStopItem" Header="Return on stop" ToggleType="CheckBox" />
              <MenuItem Name="FollowItem" Header="Follow playback" ToggleType="CheckBox" IsChecked="True" />
              <MenuItem Header="Speed">
                <MenuItem Name="Speed25Item" Header="25 %" ToggleType="Radio" GroupName="speed" />
                <MenuItem Name="Speed50Item" Header="50 %" ToggleType="Radio" GroupName="speed" />
                <MenuItem Name="Speed75Item" Header="75 %" ToggleType="Radio" GroupName="speed" />
                <MenuItem Name="Speed100Item" Header="100 %" ToggleType="Radio" GroupName="speed" IsChecked="True" />
                <MenuItem Name="Speed125Item" Header="125 %" ToggleType="Radio" GroupName="speed" />
                <MenuItem Name="Speed150Item" Header="150 %" ToggleType="Radio" GroupName="speed" />
              </MenuItem>
            </MenuItem>
            <MenuItem Header="Map">
              <MenuItem Name="AddLaneItem" Header="Add lane" />
              <MenuItem Name="FilterLanesItem" Header="Filter lanes" />
              <Separator />
              <MenuItem Name="GenerateItem" Header="Generate hitsound diff…" />
              <MenuItem Name="CopyHitsoundsItem" Header="Copy hitsounds…" />
            </MenuItem>
            <MenuItem Header="View">
              <MenuItem Name="ZoomInItem" Header="Zoom in" />
              <MenuItem Name="ZoomOutItem" Header="Zoom out" />
              <MenuItem Name="CollapseAllItem" Header="Collapse sample layers" />
              <MenuItem Name="ObjectLinesItem" Header="Object lines" ToggleType="CheckBox" IsChecked="{Binding #ObjectLinesToggle.IsChecked, Mode=TwoWay}" />
              <MenuItem Name="UsedLanesItem" Header="Only lanes with hits" ToggleType="CheckBox" IsChecked="{Binding #UsedLanesToggle.IsChecked, Mode=TwoWay}" />
              <MenuItem Name="BrowserPanelItem" Header="File browser" ToggleType="CheckBox" />
              <MenuItem Name="HistoryPanelItem" Header="History" ToggleType="CheckBox" />
              <MenuItem Name="SoundSetsPanelItem" Header="Sound sets" ToggleType="CheckBox" />
              <MenuItem Name="RangeToolItem" Header="Range selection tool" />
              <MenuItem Name="InspectorPanelItem" Header="Inspector panel" ToggleType="CheckBox" />
              <MenuItem Name="TimeSignaturesItem" Header="Time signatures…" />
              <MenuItem Name="InspectorItem" Header="UI inspector" />
              <MenuItem Name="HelpItem" Header="Shortcuts and help" />
            </MenuItem>
          </Menu>
          <!-- Keysound mode's menus: the same places as Hitsound mode's, with the key editor's commands. -->
          <Menu Name="KeysoundMenu" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="False">
            <MenuItem Header="File" Name="KsFileMenu">
              <MenuItem Header="Open…" Tag="open" />
              <MenuItem Header="Save project" Tag="save" InputGesture="Ctrl+S" />
              <MenuItem Header="Close project" Tag="ks:close" />
              <Separator />
              <MenuItem Header="Import MIDI…" Tag="ks:importMidi" />
              <MenuItem Header="Generate keysounds…" Tag="ks:generate" />
              <MenuItem Header="Open project folder" Tag="ks:projectFolder" />
              <Separator />
              <MenuItem Header="Preferences…" Tag="preferences" />
            </MenuItem>
            <MenuItem Header="Edit" Name="KsEditMenu">
              <MenuItem Header="Undo" Tag="ks:undo" InputGesture="Ctrl+Z" />
              <MenuItem Header="Redo" Tag="ks:redo" InputGesture="Ctrl+Y" />
              <Separator />
              <MenuItem Header="Cut" Tag="ks:cut" InputGesture="Ctrl+X" />
              <MenuItem Header="Copy" Tag="ks:copy" InputGesture="Ctrl+C" />
              <MenuItem Header="Paste at playhead" Tag="ks:paste" InputGesture="Ctrl+V" />
              <MenuItem Header="Duplicate" Tag="ks:duplicate" InputGesture="Ctrl+D" />
              <MenuItem Header="Delete" Tag="ks:delete" InputGesture="Delete" />
              <Separator />
              <MenuItem Header="Select all" Tag="ks:selectAll" InputGesture="Ctrl+A" />
              <Separator />
              <MenuItem Header="Quantize" Tag="ks:quantize" InputGesture="Q" />
              <MenuItem Header="Sync to gameplay objects…" Tag="ks:sync" />
            </MenuItem>
            <MenuItem Header="Track" Name="KsTrackMenu">
              <MenuItem Header="Add track" Tag="ks:addTrack" />
              <MenuItem Header="Rename track…" Tag="ks:renameTrack" />
              <MenuItem Header="Delete track" Tag="ks:deleteTrack" />
              <Separator />
              <MenuItem Header="Instrument…" Tag="ks:instrument" />
              <MenuItem Header="Open instrument editor" Tag="ks:instrumentEditor" />
            </MenuItem>
            <MenuItem Header="View" Name="KsViewMenu">
              <MenuItem Header="Zoom in" Tag="ks:zoomIn" InputGesture="H" />
              <MenuItem Header="Zoom out" Tag="ks:zoomOut" InputGesture="G" />
              <Separator />
              <MenuItem Name="KsGhostsItem" Header="Ghost notes" Tag="ks:ghosts" ToggleType="CheckBox" />
              <MenuItem Name="KsObjectLinesItem" Header="Object lines" Tag="ks:objectLines" ToggleType="CheckBox" />
              <Separator />
              <MenuItem Header="Shortcuts and help" Tag="help" InputGesture="F1" />
            </MenuItem>
          </Menu>
        </StackPanel>
        <TextBlock Grid.Column="3" Name="FileTitle" Text="No map open" Classes="projectName" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="16,0" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="PreferencesButton" Classes="flat icon" AutomationProperties.Name="Preferences" ToolTip.Tip="Preferences: Songs folder, audio output and keys (Ctrl+,)"><app:AppIcon Glyph="Settings" /></Button>
          <Button Name="HelpButton" Classes="flat icon" AutomationProperties.Name="Shortcuts and help" ToolTip.Tip="Every shortcut and mouse action, with search (F1)"><app:AppIcon Glyph="CircleHelp" /></Button>
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- 2. Toolbar (V6.39: undo/redo, tool icons, Snap + mode + divisor; view, colour, zoom and fit on the right) -->
    <Border Grid.Row="1" Grid.ColumnSpan="5" Name="ControlBar" Classes="toolbar" BorderThickness="0,0,0,1">
      <ScrollViewer Name="ControlBarScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid Name="ControlBarContent" MinWidth="1360" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="UndoButton" Classes="icon" ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><app:AppIcon Glyph="Undo2" /></Button>
          <Button Name="RedoButton" Classes="icon" ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><app:AppIcon Glyph="Redo2" /></Button>
        </StackPanel>
        <Border Grid.Column="1" Classes="tools" Margin="12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Name="SelectTool" Classes="tool" IsChecked="True" ToolTip.Tip="Select and move (1). Click, Ctrl/Shift+click, drag a box; drag hits to move them." AutomationProperties.Name="Select"><app:AppIcon Glyph="MousePointer2" /></ToggleButton>
            <ToggleButton Name="GrabTool" Classes="tool" ToolTip.Tip="Grab (2). Drag the canvas to pan time and lanes. Space plays or stops." AutomationProperties.Name="Grab"><app:AppIcon Glyph="Hand" /></ToggleButton>
            <ToggleButton Name="DrawTool" Classes="tool" ToolTip.Tip="Draw (3, or hold Alt). Click or drag along a lane; starting on a hit erases instead." AutomationProperties.Name="Draw"><app:AppIcon Glyph="Pencil" /></ToggleButton>
            <ToggleButton Name="EraseTool" Classes="tool" ToolTip.Tip="Erase (4). Drag across hits to remove them." AutomationProperties.Name="Erase"><app:AppIcon Glyph="Eraser" /></ToggleButton>
            <ToggleButton Name="MuteTool" Classes="tool" ToolTip.Tip="Mute (5). Click a hit to silence it while listening. Preview only: osu! cannot store a muted sound, so this is never saved." AutomationProperties.Name="Mute"><app:AppIcon Glyph="VolumeX" /></ToggleButton>

          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton Name="SnapToggle" Classes="viewToggle" Content="Snap" IsChecked="True" ToolTip.Tip="Snapping on / off (J)" />
          <ComboBox Name="SnapModeBox" Width="120" Focusable="True" ToolTip.Tip="Grid: dragged hits land on grid lines. Grid relative: they move by whole grid steps and keep their offset from the grid." />
          <ComboBox Name="SnapBox" Width="70" Focusable="True" ToolTip.Tip="Snap spacing: 2/1, 3/1 or 4/1 means every 2, 3 or 4 beats from each red timing point. Shift+1–9 selects 1/n; Alt+wheel cycles snaps." />
          <ToggleButton Name="TripletSnapToggle" Content="Triplets" ToolTip.Tip="Alt+wheel: on cycles 3/1, 1/1, 1/3, 1/6, 1/12; off cycles 4/1, 2/1, 1/1, 1/2, 1/4, 1/8, 1/16. The drop-down offers every spacing; Shift+number still selects 1/n." />
          <ToggleButton Name="AuditionPlacementButton" Classes="viewToggle" Content="Audition" Margin="6,0,0,0"
                        ToolTip.Tip="Play a sample whenever you draw a new note, including while painting. Saved for all projects." />
          <Button Name="GridOptionsButton" Content="Grid…" IsVisible="False" ToolTip.Tip="Grid mode and triplet cycling" />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ToggleButton Name="InspectorToggle" Classes="viewToggle" Content="Inspector" IsChecked="True" ToolTip.Tip="Show Active lane, Bookmarks and optional panels on the left" />
          <StackPanel Name="ViewExtras" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Name="LaneDetailsToggle" Classes="viewToggle" Content="Info" IsChecked="False" ToolTip.Tip="Show each lane's file index after its name" />
          <ToggleButton Name="UsedLanesToggle" Classes="viewToggle" Content="Used lanes" IsChecked="False" ToolTip.Tip="Show only the lanes that have hits on them (switch off and on again to refresh the list after adding hits)" />
          <ToggleButton Name="ObjectLinesToggle" Classes="viewToggle" Content="Object lines" IsChecked="True" ToolTip.Tip="Vertical lines down the lanes at every circle, slider head, repeat and tail, and spinner end, whatever the snap" />
          <ToggleButton Name="VolumeToggle" Classes="viewToggle" Content="Controller" IsChecked="True" ToolTip.Tip="Show the volume controller at the bottom" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Zoom" Classes="toolLabel" Margin="6,0,0,0" />
          <Slider Name="ZoomSlider" Width="100" Minimum="0" Maximum="1" Value="0.5" Focusable="True" VerticalAlignment="Center" />
          <Button Name="FitButton" Content="Fit" ToolTip.Tip="Zoom out to the whole map" />
          </StackPanel>
          </StackPanel>
          <Button Name="ViewOptionsButton" Content="View…" IsVisible="False" ToolTip.Tip="Controller, lane information, colour and zoom" />
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- 3. Selection info bar (V6.39: SELECTION · START · VOLUME · VALUE EDIT · GAMEPLAY OBJECT); song controls on the right -->
    <Border Grid.Row="2" Grid.ColumnSpan="5" Name="EditBar" Classes="info" BorderThickness="0,0,0,1">
      <ScrollViewer Name="EditBarScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid Name="EditBarContent" MinWidth="1140" ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <StackPanel Name="InfoBarLeft" Orientation="Horizontal">
        <StackPanel Name="SelectionField" Classes="field" MinWidth="130">
          <TextBlock Text="SELECTION" Classes="fieldLabel" />
          <TextBlock Name="InfoSelection" Text="No events" Classes="fieldValue" />
        </StackPanel>
        <StackPanel Name="StartField" Classes="field" MinWidth="150">
          <TextBlock Text="START · ms" Classes="fieldLabel" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Name="StartBox" Width="72" Watermark="—" ToolTip.Tip="Where the selection starts, in ms. Type a time and press Enter to move it there (several: all move together); Esc puts it back." />
            <TextBlock Name="InfoStart" Text="" Classes="fieldValue" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="VOLUME AT TIMES · %" Classes="fieldLabel" ToolTip.Tip="Edits volumes at selected times using the chosen volume scope." />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBox Name="VolumeValueBox" Width="60" Watermark="0-100" ToolTip.Tip="Volume at the selected times, using All lanes or Selected lanes. Enter or Apply commits the value." />
            <Button Name="VolumeApplyButton" Content="Apply" Focusable="True" ToolTip.Tip="Apply to the chosen volume scope at the selected times." />
          </StackPanel>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Text="VALUE EDIT" Classes="fieldLabel" />
          <ComboBox Name="VolumeModeBox" Width="100" Focusable="True" ToolTip.Tip="Relative moves every selected volume by the value; Set all gives them that value" />
        </StackPanel>
        <StackPanel Classes="field"><TextBlock Text="VOLUME SCOPE" Classes="fieldLabel" /><ComboBox Name="VolumeScopeBox" Width="130" ToolTip.Tip="All lanes changes every sound at the affected times. Selected lanes changes only the selected lanes." /></StackPanel>
        <StackPanel Name="ObjectField" Classes="field" MinWidth="200">
          <TextBlock Text="GAMEPLAY OBJECT" Classes="fieldLabel" />
          <TextBlock Name="InfoObject" Text="—" Classes="fieldValue" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="SongOptionsButton" Content="Song…" IsVisible="False" ToolTip.Tip="Song volume, mute and playback offset" />
        <StackPanel Name="SongControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="SONG" Classes="fieldLabel" VerticalAlignment="Center" />
          <Slider Name="SongVolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100" Focusable="True" VerticalAlignment="Center" ToolTip.Tip="Song volume (hitsounds unchanged)" />
          <ToggleButton Name="SongMuteButton" Content="Mute" ToolTip.Tip="Mute the song. Soloing a lane also silences it." />
          <TextBlock Text="Offset" Classes="toolLabel" />
          <TextBox Name="SongOffsetBox" Width="60" Text="0" VerticalAlignment="Center" ToolTip.Tip="Song offset in ms: positive plays the song later. Enter applies. Not saved into the map." />
          <TextBlock Text="ms" Classes="fieldLabel" VerticalAlignment="Center" />
        </StackPanel>
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- 4. Overview strip -->
    <app:OverviewStrip Grid.Row="3" Grid.Column="4" Name="Overview" />

    <!-- Inspector (left): Selection, Bookmarks, Recent edits; the splitter resizes it -->
    <app:InspectorPanel Grid.Row="3" Grid.RowSpan="3" Grid.Column="2" Name="Inspector" Background="{DynamicResource VolumeSide}" />
    <GridSplitter Grid.Row="3" Grid.RowSpan="3" Grid.Column="3" Name="InspectorSplitter" ResizeDirection="Columns" Background="{DynamicResource Divider}" />

    <!-- 5. Arrange area -->
    <Grid Grid.Row="4" Grid.Column="4" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
      <app:ArrangeView Name="Lanes" />
      <TextBox Name="LaneFilterBox" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,22,0,0" MinHeight="20" Height="20" Padding="6,0" FontSize="9" CornerRadius="5" VerticalContentAlignment="Center" Watermark="Filter samples…" />
      <ToggleButton Name="DrumMapToggle" Width="22" Height="28" MinHeight="28" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True"
                    AutomationProperties.Name="Drum-map view" ToolTip.Tip="Switch Sample / Drum-map view. Right-click for Drum Map Setup." IsEnabled="False">
        <app:AppIcon Glyph="Piano" />
        <ToggleButton.ContextMenu><ContextMenu><MenuItem Name="DrumMapSetupItem" Header="Drum Map Setup…" /></ContextMenu></ToggleButton.ContextMenu>
      </ToggleButton>
      <ScrollBar Grid.Column="1" Name="VScroll" Orientation="Vertical" />
      <ScrollBar Grid.Row="1" Name="HScroll" Orientation="Horizontal" Margin="328,0,0,0" />
    </Grid>

    <!-- Bottom panel (V6.39 controller): Controller tabs · ramp shape · hint; bars on the right -->
    <Border Grid.Row="5" Grid.Column="4" Name="BottomPanel" Background="{DynamicResource VolumeSide}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource PaneTitle}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="8,0,12,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Controller" Classes="toolLabel" Margin="0,0,6,0" />
          <RadioButton Name="VolumeTab" Classes="tab" Content="Volume" IsChecked="True" GroupName="bottom" Focusable="True" />
          <RadioButton Name="SavedTab" Classes="tab" Content="What gets saved" GroupName="bottom" Focusable="True" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
          <ToggleButton Name="RampTool" Classes="tool" ToolTip.Tip="Ramp (6). Drag in the volume lane to draw a volume ramp." AutomationProperties.Name="Ramp"><app:AppIcon Glyph="TrendingUp" /></ToggleButton>
          <TextBlock Name="VolumeScopeHint" Text="All lanes" Classes="fieldLabel" VerticalAlignment="Center" />
          <ComboBox Name="RampShapeBox" Width="110" Focusable="True" ToolTip.Tip="Shape of ramps (Shift+drag in the bars, or the Ramp tool)" />
        </StackPanel>
        <TextBlock Grid.Column="2" Name="ActiveLaneText" Classes="fieldLabel" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip.Tip="The active lane: the one touched last (highlighted in the lane list)" />
        <TextBlock Grid.Column="3" Text="Drag bars · Ctrl = spread · Alt = paint · Shift = ramp" Classes="fieldLabel" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        </Border>
        <Panel>
          <app:VolumeLane Name="Volume" />
          <ScrollViewer Name="VolumeControlScroller" HorizontalAlignment="Left" Width="347" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="VolumeControls" Margin="14,8" Spacing="8">
            <TextBlock Text="Volume" FontWeight="Bold" Foreground="{DynamicResource ButtonText}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Select" Classes="toolLabel" />
              <TextBox Name="VolumeMinBox" Width="46" Watermark="min" />
              <TextBlock Text="to" Classes="toolLabel" />
              <TextBox Name="VolumeMaxBox" Width="46" Watermark="max" />
              <Button Name="VolumeSelectButton" Content="Select" Focusable="True" ToolTip.Tip="Select every hit whose moment volume is in this range" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer Name="SavedPreview" IsVisible="False" Margin="14,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Name="SavedSummary" Foreground="{DynamicResource ButtonText}" TextWrapping="Wrap" />
              <Expander Name="SavedFields" Header="Advanced: osu! fields" HorizontalAlignment="Stretch">
                <TextBlock Name="SavedText" Foreground="{DynamicResource LcdCaption}" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Name="BrowserSplitter" Grid.Row="3" Grid.RowSpan="3" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource ChromeBorder}" />
    <Border Name="BrowserHost" Grid.Row="3" Grid.RowSpan="3" Grid.Column="0" Padding="10,8" Background="{DynamicResource PaneTitle}" />
    <!-- 7. Transport (V6.39: at the bottom) · time, position, tempo and signature · status -->
    <Border Grid.Row="6" Grid.ColumnSpan="5" Name="StatusBar" Classes="transportBar" BorderThickness="0,1,0,0">
      <ScrollViewer Name="StatusBarScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid Name="StatusBarContent" MinWidth="1520" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="12,0">
        <StackPanel Name="TransportButtons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- V6.39's locator boxes: L◀ / R◀ go to a locator; the boxes show and set it in ms (Enter). -->
          <StackPanel Name="LocatorPanel" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Name="GoLeftButton" Content="L ◀" FontSize="11" Padding="5,0" Height="28" MinHeight="28" Focusable="True" ToolTip.Tip="Go to the left locator (Ctrl+click the ruler sets it)" />
              <TextBox Name="LeftLocatorBox" Width="74" Height="28" MinHeight="28" FontSize="11" Padding="5,0" VerticalContentAlignment="Center" Watermark="L · ms" ToolTip.Tip="Left locator in ms: type a time and press Enter" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button Name="GoRightButton" Content="R ◀" FontSize="11" Padding="5,0" Height="28" MinHeight="28" Focusable="True" ToolTip.Tip="Go to the right locator (Alt+click the ruler sets it)" />
              <TextBox Name="RightLocatorBox" Width="74" Height="28" MinHeight="28" FontSize="11" Padding="5,0" VerticalContentAlignment="Center" Watermark="R · ms" ToolTip.Tip="Right locator in ms: type a time and press Enter" />
            </StackPanel>
          </StackPanel>
          <Button Name="StartButton" Classes="transport" ToolTip.Tip="Go to start (Home)" AutomationProperties.Name="Go to start">
            <app:AppIcon Glyph="SkipBack" />
          </Button>
          <Button Name="StopButton" Classes="transport" ToolTip.Tip="Stop; press again to go to the start" AutomationProperties.Name="Stop"><app:AppIcon Glyph="Square" /></Button>
          <Button Name="PlayButton" Classes="transport" ToolTip.Tip="Play / stop (Space)" AutomationProperties.Name="Play or stop"><app:AppIcon Name="PlayGlyph" Glyph="Play" /></Button>
          <ToggleButton Name="LoopButton" Classes="transport wide" ToolTip.Tip="Cycle between the L and R locators (L or /). Ctrl+click the ruler sets L, Alt+click sets R, drag in the upper ruler draws a range." AutomationProperties.Name="Loop">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <app:AppIcon Glyph="Repeat2" />
              <TextBlock Text="Cycle" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <StackPanel Name="PlaybackOptionsPanel" Spacing="2" VerticalAlignment="Center" Margin="6,0,0,0">
            <ToggleButton Name="ReturnOnStopButton" Content="Return on stop" Height="28" MinHeight="28" Padding="6,0" FontSize="11"
                          IsChecked="{Binding #ReturnOnStopItem.IsChecked, Mode=TwoWay}"
                          ToolTip.Tip="When stopping playback, return to where playback started" />
            <ToggleButton Name="FollowPlaybackButton" Content="Follow playback" Height="28" MinHeight="28" Padding="6,0" FontSize="11"
                          IsChecked="{Binding #FollowItem.IsChecked, Mode=TwoWay}"
                          ToolTip.Tip="Scroll the editing view to follow the playhead during playback" />
          </StackPanel>
          <Button Name="PlaybackOptionsButton" Content="Playback…" IsVisible="False" ToolTip.Tip="Locators, playback speed, return and follow options" />
        </StackPanel>
        <Border Grid.Column="1" Name="Lcd" Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="6" Padding="12,2" Margin="16,0,0,0" Height="44" VerticalAlignment="Center">
          <Grid ColumnDefinitions="102,88,54,84" VerticalAlignment="Center">
            <StackPanel Grid.Column="0"><TextBlock Name="LcdTime" Classes="lcd" Text="0:00.000" /><TextBlock Classes="caption" Text="TIME" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Name="LcdBar" Classes="lcd" Text="1.1.1" /><TextBlock Classes="caption" Text="BAR · BEAT · TICK" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Name="LcdBpm" Classes="lcd" Text="—" /><TextBlock Classes="caption" Text="TEMPO" /></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Name="LcdMeter" Classes="lcd" Text="4/4 /16" /><TextBlock Classes="caption" Text="SIGNATURE · SNAP" /></StackPanel>
          </Grid>
        </Border>
        <!-- Playback speed, as buttons (also Playback → Speed); the pitch stays the same -->
        <StackPanel Grid.Column="2" Name="SpeedPanel" Orientation="Horizontal" Spacing="2" Margin="16,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="Playback speed: the pitch stays the same (also Playback → Speed)" />
        <TextBlock Grid.Column="3" Name="StatusLeft" MaxWidth="144" ToolTip.Tip="{Binding #StatusLeft.Text}" VerticalAlignment="Center" FontSize="12" Margin="16,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LcdCaption}" />
        <TextBlock Grid.Column="4" Name="StatusRight" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #StatusRight.Text}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource LcdCaption}" />
        <StackPanel Grid.Column="5" Name="GlobalVolumePanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0"
                    ToolTip.Tip="Global volume: the song, hitsounds and previews together (20–100 %)">
          <TextBlock Text="Global volume" Classes="toolLabel" />
          <Slider Name="GlobalVolumeSlider" Width="88" Minimum="20" Maximum="100" Value="20" Focusable="True" VerticalAlignment="Center" />
          <TextBlock Name="GlobalVolumeText" Text="20%" Classes="fieldValue" Width="36" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <Border Name="WorkflowFooter" Grid.Row="7" Grid.ColumnSpan="5" Classes="footer" BorderThickness="0,1,0,0">
      <StackPanel Margin="12,6" Spacing="4">
        <Grid Name="WorkingCopyRow" ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Name="WorkingCopyLabel" Text="Editing:" Foreground="{DynamicResource ButtonText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Name="WorkingCopyPath" Foreground="{DynamicResource LcdCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ToggleButton Grid.Column="2" Name="WorkflowHelpToggle" Content="Output guide" Margin="8,0,0,0" />
          <Button Grid.Column="3" Name="WorkingFolderButton" Content="Open map folder" Margin="8,0,0,0" />
        </Grid>
        <Grid Name="WorkflowMessageRow" ColumnDefinitions="*,Auto" IsVisible="False">
          <ScrollViewer Name="WorkflowMessageScroll" MaxHeight="88" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <TextBlock Name="WorkflowMessage" TextWrapping="Wrap" Foreground="{DynamicResource ButtonText}" />
              <TextBlock Name="WorkflowWarning" TextWrapping="Wrap" Foreground="{DynamicResource ButtonText}" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Top">
            <Button Name="WorkflowDetailsButton" Content="Details…" />
            <Button Name="NextProblemButton" Content="Next problem" IsVisible="False" ToolTip.Tip="Select and reveal the next conflict or hit without a gameplay object. Wraps to the first problem." />
            <Button Name="WorkflowPreferencesButton" Content="Preferences…" />
            <Button Name="DismissWorkflowButton" Content="Dismiss" />
          </StackPanel>
        </Grid>
          <StackPanel Name="WorkflowHelpPanel" Spacing="4" IsVisible="False">
            <TextBlock Text="Save .osu updates the difficulty shown above. Generate creates a separate [Hitsounds] difficulty. Copy hitsounds applies a source difficulty's sounds to chosen difficulties." TextWrapping="Wrap" Foreground="{DynamicResource ButtonText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="WorkflowBackupsButton" Content="Open backups" />
              <Button Name="QuickStartButton" Content="Quick start" />
            </StackPanel>
          </StackPanel>
      </StackPanel>
    </Border>
    <!-- The start screen: under the title bar, over the empty editor, until a map opens -->
    <app:KeysoundEditor Name="Keys" Grid.Row="1" Grid.RowSpan="7" Grid.ColumnSpan="5" ZIndex="40" IsVisible="False" />
    <app:StartScreen Name="Start" Grid.Row="1" Grid.RowSpan="7" Grid.ColumnSpan="5" ZIndex="50" IsVisible="False" />
    <!-- The tutorial: over everything, hidden until it runs -->
    <app:TutorialOverlay Name="Tutorial" Grid.RowSpan="8" Grid.ColumnSpan="5" ZIndex="100" />
  </Grid>
  </DockPanel>
</Window>
