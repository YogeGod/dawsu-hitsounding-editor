<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>OsuHitsoundEditor</AssemblyName>
    <Version>2.2.1</Version>
    <Product>dawsu! hitsound studio</Product>
    <ApplicationIcon>Assets\dawsu.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsuHitsound.Audio\OsuHitsound.Audio.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Vst3NativeDirectory Condition="'$(Vst3HostDll)' != ''">$([System.IO.Path]::GetDirectoryName('$(Vst3HostDll)'))</Vst3NativeDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(Vst3NativeDirectory)' != ''">
    <None Include="$(Vst3HostDll)" Link="dawsu_vst3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(Vst3NativeDirectory)/dawsu_vst3_scan.exe" Link="dawsu_vst3_scan.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keysound mode's isolated VST3 host (native/Vst3IsolatedHost): copied beside the app when given. -->
  <ItemGroup Condition="'$(Vst3IsolatedHostExe)' != ''">
    <None Include="$(Vst3IsolatedHostExe)" Link="dawsu_vst3_host.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Published builds start from dawsu!.exe. The launcher has the app's DLL name built in, so only the file is
       renamed; the assembly, its resources and the settings folder keep their names. -->
  <Target Name="NameTheExe" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)dawsu!.exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="OsuHitsound.App.Tests" />
    <InternalsVisibleTo Include="Snapshot" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets\** already embeds the start-screen fonts. The OFL texts stay readable beside the app. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\OFL-*.txt" />
    <None Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ui-theme.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
