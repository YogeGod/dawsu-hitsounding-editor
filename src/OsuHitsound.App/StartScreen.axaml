<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsuHitsound.App.StartScreen"
             Background="{DynamicResource InfoBg}">
  <UserControl.Resources>
    <FontFamily x:Key="StartHeading">avares://OsuHitsoundEditor/Assets/Fonts#Archivo Expanded, $Default</FontFamily>
    <FontFamily x:Key="StartMono">avares://OsuHitsoundEditor/Assets/Fonts#Martian Mono, Cascadia Mono, Consolas</FontFamily>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.startPanel">
      <Setter Property="Width" Value="252" />
      <Setter Property="Height" Value="252" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.startPanel:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PaneTitle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
    </Style>
    <Style Selector="Button.startPanel:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
    </Style>
    <Style Selector="Button.startPanel:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonActive}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.startPanel:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
    </Style>
    <Style Selector="Button.startPanel Path.icon">
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.startPanel TextBlock.label">
      <Setter Property="FontFamily" Value="{StaticResource StartHeading}" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,18,0,0" />
    </Style>
    <Style Selector="Button.startPanel TextBlock.sub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="190" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource StartMono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonText}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="-8" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
      <Setter Property="Background" Value="{DynamicResource LcdBg}" />
    </Style>
    <Style Selector="Button.footLink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.footLink.available">
      <Setter Property="Foreground" Value="{DynamicResource Brand}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Name="StartScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Border Padding="20">
  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" RowDefinitions="Auto,22,Auto,Auto,22,Auto">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
        <Button Name="UpdateLink" Classes="footLink" Content="Check for updates" Padding="6,2" Margin="0,0,0,1" />
        <TextBlock Name="Version" VerticalAlignment="Center" Classes="mono" Foreground="{DynamicResource TextDim}" FontSize="11" Text="hitsound studio" />
      </StackPanel>
      <TextBlock FontFamily="{StaticResource StartHeading}" FontWeight="ExtraBold" FontSize="26" Foreground="{DynamicResource ButtonText}">
        <Run Text="dawsu" /><Run Text="!" Foreground="{DynamicResource Brand}" />
      </TextBlock>
    </DockPanel>

    <UniformGrid Grid.Row="2" Columns="2" Rows="2" ColumnSpacing="16" RowSpacing="16">
      <Button Name="OpenPanel" Classes="startPanel" AutomationProperties.Name="Open beatmap file"
              ToolTip.Tip="Open a .osu, or import an .osz into your Songs folder (Ctrl+O). You can also drop either onto the window.">
        <Grid>
          <Border Classes="chip"><TextBlock Classes="mono" Text="Ctrl+O" Foreground="{DynamicResource LcdCaption}" /></Border>
          <StackPanel VerticalAlignment="Center">
            <Viewbox Width="58" Height="58"><Path Classes="icon" Data="{StaticResource IconFolderOpen}" Stroke="{DynamicResource WaveLow}" Width="24" Height="24" /></Viewbox>
            <TextBlock Classes="label" Text="Open beatmap file" />
            <TextBlock Classes="sub"><Run FontFamily="{StaticResource StartMono}" FontSize="11" Foreground="{DynamicResource ButtonText}" Text=".osu" /><Run Text=" or " /><Run FontFamily="{StaticResource StartMono}" FontSize="11" Foreground="{DynamicResource ButtonText}" Text=".osz" /><Run Text=", or drop one onto the window" /></TextBlock>
          </StackPanel>
        </Grid>
      </Button>

      <Button Name="RecentPanel" Classes="startPanel" AutomationProperties.Name="Edit recent project">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft" />
        </Button.Flyout>
        <StackPanel VerticalAlignment="Center">
          <Viewbox Width="58" Height="58"><Path Classes="icon" Data="{StaticResource IconHistory}" Stroke="{DynamicResource WaveMid}" Width="24" Height="24" /></Viewbox>
          <TextBlock Classes="label" Text="Edit recent project" />
          <TextBlock Name="RecentCaption" Classes="sub" Text="Nothing opened yet" />
          <TextBlock Name="RecentName" Classes="mono" HorizontalAlignment="Center" MaxWidth="212" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" IsVisible="False" />
        </StackPanel>
      </Button>

      <Button Name="SamplesPanel" Classes="startPanel" AutomationProperties.Name="Edit samples"
              ToolTip.Tip="Go to the editor with the file browser and the inspector's Active lane card open">
        <StackPanel VerticalAlignment="Center">
          <Viewbox Width="58" Height="58"><Path Classes="icon" Data="{StaticResource IconAudioWaveform}" Stroke="{DynamicResource WaveHigh}" Width="24" Height="24" /></Viewbox>
          <TextBlock Classes="label" Text="Edit samples" />
          <TextBlock Classes="sub" Text="Browse and audition samples in the File browser" />
        </StackPanel>
      </Button>

      <Button Name="KeysoundPanel" Classes="startPanel" AutomationProperties.Name="Keysounding"
              ToolTip.Tip="Compose pitched notes against a beatmap in a separate Keysound project. The beatmap is copied into the project and never changed.">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Name="KeysoundNewItem" Header="New project from a beatmap…" />
            <MenuItem Name="KeysoundOpenItem" Header="Open Keysound project…" />
          </MenuFlyout>
        </Button.Flyout>
        <StackPanel VerticalAlignment="Center">
          <Viewbox Width="58" Height="58"><Path Classes="icon" Data="{StaticResource IconKeyboardMusic}" Stroke="{DynamicResource Brand}" Width="24" Height="24" /></Viewbox>
          <TextBlock Classes="label" Text="Keysounding" />
          <TextBlock Classes="sub" Text="New project from a beatmap, or open one" />
        </StackPanel>
      </Button>
    </UniformGrid>

    <Border Name="MessagePanel" Grid.Row="3" IsVisible="False" Margin="0,16,0,0" Padding="12" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="1" CornerRadius="4">
      <TextBlock Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource ButtonText}" AutomationProperties.Name="Start screen status" />
    </Border>
    <Border Grid.Row="5" BorderBrush="{DynamicResource LineDivider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Songs folder" FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
          <TextBlock Name="SongsFolder" Classes="mono" FontSize="11" Foreground="{DynamicResource LcdCaption}" MaxWidth="170" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" Text="not set" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-10,0,0,0">
          <Button Name="PreferencesLink" Classes="footLink" Content="Preferences…" />
          <Button Name="QuickStartLink" Classes="footLink" Content="Quick start" />
          <Button Name="KeysLink" Classes="footLink" ToolTip.Tip="Keyboard shortcuts (F1)">
            <TextBlock><Run Text="Shortcuts " /><Run FontFamily="{StaticResource StartMono}" FontSize="11" Text="F1" Foreground="{DynamicResource LcdCaption}" /></TextBlock>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
  </Border>
  </ScrollViewer>
</UserControl>
