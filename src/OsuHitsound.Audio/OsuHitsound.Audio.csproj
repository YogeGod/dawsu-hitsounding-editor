<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The BASS bindings and native libraries osu!lazer ships with. BASS is free for non-commercial use. -->
    <PackageReference Include="ppy.ManagedBass" Version="2022.1216.0" />
    <PackageReference Include="ppy.ManagedBass.Fx" Version="2022.1216.0" />
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2025.806.0-nativelibs" />
    <!-- NAudio (MIT) sends the mixed stream to the device: WASAPI, ASIO, DirectSound or MME. BASS only decodes. -->
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
    <PackageReference Include="NAudio.Dmo" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsuHitsound.Lanes\OsuHitsound.Lanes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OsuHitsound.Audio.Tests" />
    <InternalsVisibleTo Include="OsuHitsound.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- osu!'s classic default hitsounds (CC BY-NC 4.0, see DefaultSamples/README.md): played when osu!lazer isn't installed. -->
    <EmbeddedResource Include="DefaultSamples\*.wav" LogicalName="DefaultSamples.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
